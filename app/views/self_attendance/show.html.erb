<% content_for :title, "マイ打刻" %>

<div class="min-h-screen bg-[radial-gradient(circle_at_top_left,_rgba(14,165,233,0.10),_transparent_30%),linear-gradient(180deg,#f8fafc_0%,#eef6ff_100%)]">
  <div class="mx-auto flex min-h-screen max-w-6xl flex-col gap-6 px-4 py-6">
    <header class="rounded-3xl border border-white/70 bg-white/80 p-5 shadow-sm backdrop-blur">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-600">My Attendance</p>
          <h1 class="mt-2 text-3xl font-semibold text-slate-900">マイ打刻</h1>
          <p class="mt-2 text-sm text-slate-600"><%= current_employee.title %> / <%= current_tenant.name %></p>
        </div>
        <div class="flex flex-wrap gap-2">
          <% if @admin_entry_path.present? %>
            <%= link_to "管理画面へ", @admin_entry_path, class: "rounded-full border border-sky-200 bg-sky-50 px-4 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
          <% end %>
          <%= button_to "ログアウト", destroy_user_session_path, method: :delete, form: { data: { turbo: true } }, class: "rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
        </div>
      </div>
    </header>

    <div class="grid gap-4 lg:grid-cols-[1.1fr_0.9fr]">
      <section class="space-y-4">
        <div class="grid gap-4 md:grid-cols-3">
          <div class="rounded-3xl border border-white/70 bg-white/80 p-5 shadow-sm backdrop-blur">
            <div class="text-xs text-slate-500">対象日</div>
            <div class="mt-2 text-2xl font-bold text-slate-900"><%= jp_date(@selected_date) %></div>
          </div>
          <div class="rounded-3xl border border-white/70 bg-white/80 p-5 shadow-sm backdrop-blur">
            <div class="text-xs text-slate-500">現在の状態</div>
            <div class="mt-2"><%= attendance_status_badge(@target_attendance_record || AttendanceRecord.new(status: "draft")) %></div>
          </div>
          <div class="rounded-3xl border border-white/70 bg-white/80 p-5 shadow-sm backdrop-blur">
            <div class="text-xs text-slate-500">今日のシフト</div>
            <div class="mt-2 text-sm font-semibold text-slate-900">
              <% if @today_work_shift.present? %>
                <%= hhmm(@today_work_shift.start_time) %> - <%= hhmm(@today_work_shift.end_time) %>
              <% else %>
                シフト未登録
              <% end %>
            </div>
          </div>
        </div>

        <div class="rounded-3xl border border-white/70 bg-white/80 p-6 shadow-sm backdrop-blur">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-lg font-semibold text-slate-900">本日の打刻</h2>
              <p class="mt-1 text-sm text-slate-600">自分の出勤・退勤だけを登録できます。</p>
            </div>
            <%= form_with url: my_attendance_path, method: :get, local: true, class: "flex items-end gap-2" do |f| %>
              <div>
                <label class="block text-xs font-semibold tracking-wide text-slate-500">表示日</label>
                <%= f.date_field :date, value: @selected_date, class: "mt-1 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm" %>
              </div>
              <%= f.submit "表示", class: "rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
            <% end %>
          </div>

          <div class="mt-5 grid gap-4 lg:grid-cols-2">
            <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4">
              <h3 class="text-sm font-semibold text-slate-900">出勤</h3>
              <% if @attendance_record&.clock_in_at.present? %>
                <p class="mt-3 text-sm text-slate-600">この日の出勤打刻は <span class="font-semibold text-slate-900"><%= jp_datetime(@attendance_record.clock_in_at) %></span> に登録済みです。</p>
              <% else %>
                <%= form_with url: clock_in_my_attendance_path, method: :post, local: true, class: "mt-4 space-y-3" do %>
                  <div class="grid gap-3 sm:grid-cols-2">
                    <div>
                      <label class="block text-xs font-semibold tracking-wide text-slate-500">出勤日</label>
                      <%= date_field_tag :clock_in_on, @clock_in_defaults[:clock_in_on], class: "mt-1 w-full rounded-lg border border-amber-200 bg-white px-3 py-2 text-sm" %>
                    </div>
                    <div>
                      <label class="block text-xs font-semibold tracking-wide text-slate-500">出勤時刻</label>
                      <%= time_field_tag :clock_in_time, @clock_in_defaults[:clock_in_time], class: "mt-1 w-full rounded-lg border border-amber-200 bg-white px-3 py-2 text-sm" %>
                    </div>
                  </div>
                  <div>
                    <label class="block text-xs font-semibold tracking-wide text-slate-500">メモ</label>
                    <%= text_field_tag :note, nil, placeholder: "必要なら入力", class: "mt-1 w-full rounded-lg border border-amber-200 bg-white px-3 py-2 text-sm" %>
                  </div>
                  <%= submit_tag "出勤を打刻", class: "rounded-lg bg-amber-600 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-700" %>
                <% end %>
              <% end %>
            </div>

            <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4">
              <h3 class="text-sm font-semibold text-slate-900">退勤</h3>
              <% if @target_attendance_record&.working? %>
                <%= form_with scope: :attendance_record, url: clock_out_my_attendance_path, method: :patch, local: true, class: "mt-4 space-y-3" do |f| %>
                  <%= hidden_field_tag "attendance_record[attendance_record_id]", @target_attendance_record.id %>
                  <div class="grid gap-3 sm:grid-cols-2">
                    <div>
                      <label class="block text-xs font-semibold tracking-wide text-slate-500">退勤日</label>
                      <%= date_field_tag "attendance_record[clock_out_on]", @clock_out_defaults[:clock_out_on], class: "mt-1 w-full rounded-lg border border-emerald-200 bg-white px-3 py-2 text-sm" %>
                    </div>
                    <div>
                      <label class="block text-xs font-semibold tracking-wide text-slate-500">退勤時刻</label>
                      <%= time_field_tag "attendance_record[clock_out_time]", @clock_out_defaults[:clock_out_time], class: "mt-1 w-full rounded-lg border border-emerald-200 bg-white px-3 py-2 text-sm" %>
                    </div>
                    <div>
                      <label class="block text-xs font-semibold tracking-wide text-slate-500">休憩時間（分）</label>
                      <%= f.number_field :break_minutes, value: @target_attendance_record.break_minutes, min: 0, step: 1, class: "mt-1 w-full rounded-lg border border-emerald-200 bg-white px-3 py-2 text-sm" %>
                    </div>
                  </div>
                  <div>
                    <label class="block text-xs font-semibold tracking-wide text-slate-500">メモ</label>
                    <%= text_area_tag "attendance_record[note]", @target_attendance_record.note, rows: 3, class: "mt-1 w-full rounded-lg border border-emerald-200 bg-white px-3 py-2 text-sm" %>
                  </div>
                  <%= f.submit "退勤を打刻", class: "rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700" %>
                <% end %>
              <% elsif @attendance_record&.closed? %>
                <p class="mt-3 text-sm text-slate-600">この日の退勤打刻は <span class="font-semibold text-slate-900"><%= jp_datetime(@attendance_record.clock_out_at) %></span> に確定済みです。</p>
              <% else %>
                <p class="mt-3 text-sm text-slate-600">勤務中の出勤打刻がありません。</p>
              <% end %>
            </div>
          </div>
        </div>
      </section>

      <aside class="space-y-4">
        <div class="rounded-3xl border border-white/70 bg-white/80 p-5 shadow-sm backdrop-blur">
          <h2 class="text-sm font-semibold text-slate-900">現在の勤怠</h2>
          <% if @target_attendance_record.present? %>
            <dl class="mt-4 space-y-3 text-sm text-slate-700">
              <div>
                <dt class="text-xs text-slate-500">出勤時刻</dt>
                <dd><%= jp_datetime(@target_attendance_record.clock_in_at) %></dd>
              </div>
              <div>
                <dt class="text-xs text-slate-500">退勤時刻</dt>
                <dd><%= jp_datetime(@target_attendance_record.clock_out_at) %></dd>
              </div>
              <div>
                <dt class="text-xs text-slate-500">実働</dt>
                <dd><%= @target_attendance_record.worked_minutes %> 分</dd>
              </div>
              <div>
                <dt class="text-xs text-slate-500">残業</dt>
                <dd><%= @target_attendance_record.overtime_minutes %> 分</dd>
              </div>
            </dl>
          <% else %>
            <p class="mt-3 text-sm text-slate-600">この日の勤怠はまだありません。</p>
          <% end %>
        </div>

        <div class="rounded-3xl border border-white/70 bg-white/80 p-5 shadow-sm backdrop-blur">
          <h2 class="text-sm font-semibold text-slate-900">最近の履歴</h2>
          <% if @recent_attendance_records.any? %>
            <div class="mt-4 space-y-2">
              <% @recent_attendance_records.each do |attendance_record| %>
                <div class="rounded-2xl border border-slate-100 bg-slate-50 px-4 py-3 text-sm text-slate-700">
                  <div class="flex items-center justify-between gap-3">
                    <div>
                      <div class="font-semibold text-slate-900"><%= jp_date(attendance_record.work_date) %></div>
                      <div class="text-xs text-slate-500"><%= jp_datetime(attendance_record.clock_in_at) %> - <%= jp_datetime(attendance_record.clock_out_at) %></div>
                    </div>
                    <div class="text-right">
                      <div><%= attendance_status_badge(attendance_record) %></div>
                      <div class="mt-1 text-xs text-slate-500">実働 <%= attendance_record.worked_minutes %> 分</div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="mt-3 text-sm text-slate-600">まだ打刻履歴はありません。</p>
          <% end %>
        </div>
      </aside>
    </div>
  </div>
</div>
