<% content_for :title, "経費申請詳細" %>

<div class="min-h-screen bg-[radial-gradient(circle_at_top_left,_rgba(14,165,233,0.10),_transparent_30%),linear-gradient(180deg,#f8fafc_0%,#eef6ff_100%)]">
  <div class="mx-auto flex min-h-screen max-w-2xl flex-col gap-6 px-4 py-6">
    <header class="rounded-3xl border border-white/70 bg-white/80 p-5 shadow-sm backdrop-blur">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-600">Expense Report</p>
          <h1 class="mt-2 text-2xl font-semibold text-slate-900">経費申請詳細</h1>
          <p class="mt-1 text-sm text-slate-600"><%= @expense_report.expensed_on.strftime("%Y/%m/%d") %></p>
        </div>
        <%= link_to "一覧へ戻る", my_expense_reports_path, class: "rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
      </div>
    </header>

    <div class="rounded-3xl border border-white/70 bg-white/80 p-6 shadow-sm backdrop-blur">
      <dl class="space-y-4 text-sm text-slate-800">
        <div>
          <dt class="text-xs text-slate-500">ステータス</dt>
          <dd class="mt-1">
            <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold
              <%= case @expense_report.status
                  when 'approved' then 'bg-emerald-100 text-emerald-700'
                  when 'rejected' then 'bg-rose-100 text-rose-700'
                  else 'bg-amber-100 text-amber-700'
                  end %>">
              <%= case @expense_report.status
                  when "approved" then "承認済"
                  when "rejected" then "却下"
                  else "承認待ち"
                  end %>
            </span>
          </dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">経費区分</dt>
          <dd class="mt-1">
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">
              <%= expense_category_label(@expense_report.category) %>
            </span>
          </dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">金額</dt>
          <dd class="mt-1 text-xl font-bold text-slate-900">¥<%= number_with_delimiter(@expense_report.amount.to_i) %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">内容</dt>
          <dd class="mt-1 rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
            <%= simple_format(@expense_report.description) %>
          </dd>
        </div>
        <% if @expense_report.purpose.present? %>
          <div>
            <dt class="text-xs text-slate-500">目的</dt>
            <dd class="mt-1 rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
              <%= simple_format(@expense_report.purpose) %>
            </dd>
          </div>
        <% end %>
        <% if @expense_report.note.present? %>
          <div>
            <dt class="text-xs text-slate-500">備考</dt>
            <dd class="mt-1 rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
              <%= simple_format(@expense_report.note) %>
            </dd>
          </div>
        <% end %>
        <div>
          <dt class="text-xs text-slate-500">申請日時</dt>
          <dd class="mt-1 text-slate-600"><%= @expense_report.created_at.strftime("%Y/%m/%d %H:%M") %></dd>
        </div>
      </dl>
    </div>

    <div class="flex gap-2">
      <%= link_to "一覧へ戻る", my_expense_reports_path, class: "rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
    </div>
  </div>
</div>
