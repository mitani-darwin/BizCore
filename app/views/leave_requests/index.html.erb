<% content_for :title, "マイ有給申請" %>

<div class="min-h-screen bg-[radial-gradient(circle_at_top_left,_rgba(14,165,233,0.10),_transparent_30%),linear-gradient(180deg,#f8fafc_0%,#eef6ff_100%)]">
  <div class="mx-auto flex min-h-screen max-w-4xl flex-col gap-6 px-4 py-6">
    <header class="rounded-3xl border border-white/70 bg-white/80 p-5 shadow-sm backdrop-blur">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-600">My Leave Requests</p>
          <h1 class="mt-2 text-3xl font-semibold text-slate-900">マイ有給申請</h1>
          <p class="mt-2 text-sm text-slate-600"><%= current_employee.name %> / <%= current_tenant.name %></p>
        </div>
        <div class="flex flex-wrap gap-2">
          <%= link_to "新規申請", new_my_leave_request_path, class: "rounded-full bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
          <%= link_to "打刻画面へ", my_attendance_path, class: "rounded-full border border-sky-200 bg-sky-50 px-4 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
          <%= button_to "ログアウト", destroy_user_session_path, method: :delete, form: { data: { turbo: true } }, class: "rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
        </div>
      </div>
    </header>

    <div class="rounded-3xl border border-white/70 bg-white/80 p-5 shadow-sm backdrop-blur">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-slate-900">有給残日数</h2>
      </div>
      <div class="mt-3 flex items-end gap-2">
        <span class="text-4xl font-bold <%= @remaining_days <= 0 ? 'text-rose-700' : 'text-sky-700' %>"><%= @remaining_days.to_d %></span>
        <span class="mb-1 text-sm text-slate-600">日</span>
      </div>
    </div>

    <div class="rounded-3xl border border-white/70 bg-white/80 p-5 shadow-sm backdrop-blur">
      <h2 class="text-lg font-semibold text-slate-900">申請履歴</h2>
      <% if @leave_requests.any? %>
        <div class="mt-4 space-y-3">
          <% @leave_requests.each do |leave_request| %>
            <% status_style = case leave_request.status
               when "approved" then "bg-emerald-50 border-emerald-200"
               when "rejected" then "bg-rose-50 border-rose-200"
               else "bg-amber-50 border-amber-200"
               end %>
            <div class="rounded-2xl border <%= status_style %> p-4">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-sm font-semibold text-slate-900">
                      <%= leave_request.start_date.strftime("%Y/%m/%d") %>
                      <% if leave_request.start_date != leave_request.end_date %>
                        〜 <%= leave_request.end_date.strftime("%Y/%m/%d") %>
                      <% end %>
                    </span>
                    <span class="rounded-full px-2 py-0.5 text-xs font-semibold
                      <%= case leave_request.leave_type
                          when 'paid_leave'    then 'bg-sky-100 text-sky-700'
                          when 'special_leave' then 'bg-violet-100 text-violet-700'
                          end %>">
                      <%= leave_request.leave_type == "paid_leave" ? "有給休暇" : "特別休暇" %>
                    </span>
                  </div>
                  <p class="mt-1 text-xs text-slate-600"><%= leave_request.days_count.to_d %> 日間
                    <% if leave_request.reason.present? %> ・ <%= leave_request.reason.truncate(40) %><% end %>
                  </p>
                </div>
                <div class="flex shrink-0 items-center gap-2">
                  <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold
                    <%= case leave_request.status
                        when 'approved' then 'bg-emerald-100 text-emerald-700'
                        when 'rejected' then 'bg-rose-100 text-rose-700'
                        else 'bg-amber-100 text-amber-700'
                        end %>">
                    <%= case leave_request.status
                        when "approved" then "承認済"
                        when "rejected" then "却下"
                        else "承認待ち"
                        end %>
                  </span>
                  <%= link_to "詳細", my_leave_request_path(leave_request), class: "rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="mt-4 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
          <p>申請履歴はありません。</p>
          <div class="mt-3">
            <%= link_to "最初の申請を作成する", new_my_leave_request_path, class: "inline-block rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
