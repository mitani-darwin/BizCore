<% content_for :title, "有給申請詳細" %>

<div class="min-h-screen bg-[radial-gradient(circle_at_top_left,_rgba(14,165,233,0.10),_transparent_30%),linear-gradient(180deg,#f8fafc_0%,#eef6ff_100%)]">
  <div class="mx-auto flex min-h-screen max-w-2xl flex-col gap-6 px-4 py-6">
    <header class="rounded-3xl border border-white/70 bg-white/80 p-5 shadow-sm backdrop-blur">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-600">Leave Request</p>
          <h1 class="mt-2 text-2xl font-semibold text-slate-900">有給申請詳細</h1>
          <p class="mt-1 text-sm text-slate-600">
            <%= @leave_request.start_date.strftime("%Y/%m/%d") %>
            <% if @leave_request.start_date != @leave_request.end_date %>
              〜 <%= @leave_request.end_date.strftime("%Y/%m/%d") %>
            <% end %>
          </p>
        </div>
        <%= link_to "一覧へ戻る", my_leave_requests_path, class: "rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
      </div>
    </header>

    <div class="rounded-3xl border border-white/70 bg-white/80 p-6 shadow-sm backdrop-blur">
      <dl class="space-y-4 text-sm text-slate-800">
        <div>
          <dt class="text-xs text-slate-500">ステータス</dt>
          <dd class="mt-1">
            <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold
              <%= case @leave_request.status
                  when 'approved' then 'bg-emerald-100 text-emerald-700'
                  when 'rejected' then 'bg-rose-100 text-rose-700'
                  else 'bg-amber-100 text-amber-700'
                  end %>">
              <%= case @leave_request.status
                  when "approved" then "承認済"
                  when "rejected" then "却下"
                  else "承認待ち"
                  end %>
            </span>
          </dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">休暇種別</dt>
          <dd class="mt-1 flex flex-wrap items-center gap-2">
            <span class="rounded-full px-2 py-0.5 text-xs font-semibold
              <%= @leave_request.leave_type == 'paid_leave' ? 'bg-sky-100 text-sky-700' : 'bg-violet-100 text-violet-700' %>">
              <%= @leave_request.leave_type == "paid_leave" ? "有給休暇" : "特別休暇" %>
            </span>
            <% unless @leave_request.half_day_type_none? %>
              <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-700">
                <%= @leave_request.half_day_type_morning? ? "午前半休" : "午後半休" %>
              </span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">期間</dt>
          <dd class="mt-1">
            <%= @leave_request.start_date.strftime("%Y/%m/%d") %>
            <% if @leave_request.start_date != @leave_request.end_date %>
              〜 <%= @leave_request.end_date.strftime("%Y/%m/%d") %>
            <% end %>
            （<%= @leave_request.days_count.to_d %> 日間）
          </dd>
        </div>
        <% if @leave_request.reason.present? %>
          <div>
            <dt class="text-xs text-slate-500">申請理由</dt>
            <dd class="mt-1 rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
              <%= simple_format(@leave_request.reason) %>
            </dd>
          </div>
        <% end %>
        <% if @leave_request.note.present? %>
          <div>
            <dt class="text-xs text-slate-500">備考</dt>
            <dd class="mt-1 rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
              <%= simple_format(@leave_request.note) %>
            </dd>
          </div>
        <% end %>
        <div>
          <dt class="text-xs text-slate-500">申請日時</dt>
          <dd class="mt-1 text-slate-600"><%= @leave_request.created_at.strftime("%Y/%m/%d %H:%M") %></dd>
        </div>
      </dl>
    </div>

    <div class="flex gap-2">
      <%= link_to "一覧へ戻る", my_leave_requests_path, class: "rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
    </div>
  </div>
</div>
