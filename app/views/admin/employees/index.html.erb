<% content_for :page_title, "従業員一覧" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">従業員一覧</h1>
      <p class="text-sm text-slate-600">出退勤、残業、有給、給与計算の基礎となる従業員情報です。</p>
    </div>
    <% if can?("admin.employees.create") %>
      <%= link_to "新規従業員", new_admin_employee_path, class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
    <% end %>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: admin_employees_path, method: :get, local: true, class: "grid gap-3 md:grid-cols-[minmax(0,2fr)_180px_180px_auto_auto]" do |f| %>
      <div>
        <%= f.label :q, "検索", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.text_field :q, value: @filters[:q], placeholder: "コード・氏名・メール・電話で検索", class: "mt-1 w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm shadow-sm placeholder:text-slate-400 focus:border-sky-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>
      <div>
        <%= f.label :status, "在籍状態", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.select :status, options_for_select([["すべて", ""]] + employee_status_options, @filters[:status]), {}, class: "mt-1 w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm shadow-sm placeholder:text-slate-400 focus:border-sky-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>
      <div>
        <%= f.label :employment_type, "雇用区分", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.select :employment_type, options_for_select([["すべて", ""]] + employment_type_options, @filters[:employment_type]), {}, class: "mt-1 w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm shadow-sm placeholder:text-slate-400 focus:border-sky-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>
      <div class="flex items-end">
        <%= f.submit "絞り込む", class: "w-full rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      </div>
      <div class="flex items-end">
        <%= link_to "条件をクリア", admin_employees_path, class: "w-full rounded-lg border border-slate-200 bg-white px-4 py-2 text-center text-sm text-slate-700 hover:bg-slate-50" %>
      </div>
    <% end %>

    <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">対象従業員</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @employee_summary[:count] %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">在籍中</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @employee_summary[:active_count] %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">時給制</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @employee_summary[:hourly_count] %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">残有給合計</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @employee_summary[:total_paid_leave_balance].to_d %> 日</div>
      </div>
    </div>
  </div>

  <% if @employees.any? %>
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">状態</th>
            <th class="px-4 py-2">コード</th>
            <th class="px-4 py-2">従業員</th>
            <th class="px-4 py-2">雇用区分</th>
            <th class="px-4 py-2">入社日</th>
            <th class="px-4 py-2">給与条件</th>
            <th class="px-4 py-2 text-right">残有給</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @employees.each do |employee| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2"><%= employee_status_badge(employee) %></td>
              <td class="px-4 py-2 font-semibold text-slate-900"><%= employee.employee_code %></td>
              <td class="px-4 py-2 text-slate-700">
                <div class="font-semibold text-slate-900"><%= employee.name %></div>
                <div class="text-xs text-slate-500"><%= employee.email.presence || employee.tel.presence || "-" %></div>
              </td>
              <td class="px-4 py-2"><%= employment_type_badge(employee) %></td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(employee.joined_on) %></td>
              <td class="px-4 py-2 text-slate-700">
                <% if employee.employment_type_hourly? %>
                  時給 <span class="font-semibold text-slate-900"><%= money(employee.base_hourly_wage) %></span>
                <% else %>
                  月給 <span class="font-semibold text-slate-900"><%= money(employee.base_monthly_salary) %></span>
                <% end %>
              </td>
              <td class="px-4 py-2 text-right text-slate-700"><%= employee.remaining_paid_leave_days %> 日</td>
              <td class="px-4 py-2 text-right">
                <div class="inline-flex gap-2">
                  <%= link_to "詳細", admin_employee_path(employee), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
                  <% if can?("admin.employees.update") %>
                    <%= link_to "編集", edit_admin_employee_path(employee), class: "rounded border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "shared/pagy", pagy: @pagy %>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <p><%= @filters.values.any?(&:present?) ? "条件に一致する従業員がありません。" : "従業員がまだ登録されていません。" %></p>
    </div>
  <% end %>
</div>
