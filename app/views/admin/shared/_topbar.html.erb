<header class="sticky top-0 z-30 h-14 border-b border-slate-200 bg-white">
  <div class="mx-auto flex h-full max-w-full items-center justify-between px-4">

    <!-- ページタイトル（content_for :page_title） -->
    <div class="flex flex-col gap-1">
      <%= render "admin/shared/breadcrumbs" %>
      <h1 class="text-sm font-semibold text-slate-700">
        <%= content_for?(:page_title) ? yield(:page_title) : (page_title || "") %>
      </h1>
    </div>

    <div class="flex items-center gap-3">
      <% if current_employee.present? %>
        <%= link_to "マイ打刻",
            my_attendance_path,
            class: "rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 hover:bg-emerald-100" %>
      <% end %>

      <div class="text-right text-[11px] leading-tight text-slate-600">
        <div class="font-semibold text-slate-800"><%= current_user&.name %></div>
        <div><%= current_user&.email %></div>
      </div>

      <%= link_to "🔑 パスワード変更",
          edit_password_admin_profile_path,
          class: "rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700 hover:bg-sky-100" %>

      <div class="text-[11px] text-slate-500">
        <%= current_tenant&.name.presence || "Tenant not set" %>
      </div>

      <%= button_to "ログアウト",
          destroy_user_session_path,
          method: :delete,
          form: { data: { turbo: true } },
          class: "rounded-full border border-rose-200 bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-700 hover:bg-rose-100" %>
    </div>
</header>
