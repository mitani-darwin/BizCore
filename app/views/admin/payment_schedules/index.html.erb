<% content_for :page_title, "支払予定表" %>

<div class="space-y-4">
  <div>
    <h1 class="text-xl font-semibold text-slate-900">支払予定表</h1>
    <p class="text-sm text-slate-600">仕入請求ごとの支払予定を期日順に確認し、滞留や直近支払を把握します。</p>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: admin_payment_schedules_path, method: :get, local: true, class: "grid gap-3 md:grid-cols-[minmax(0,2fr)_220px_180px_180px_auto_auto]" do |f| %>
      <div>
        <%= f.label :q, "検索", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.text_field :q, value: @filters[:q], placeholder: "仕入先名・コード・担当者・メールで検索", class: "mt-1 w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm shadow-sm placeholder:text-slate-400 focus:border-sky-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>
      <div>
        <%= f.label :status, "取引状態", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.select :status, options_for_select([["すべて", ""]] + supplier_status_options, @filters[:status]), {}, class: "mt-1 w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm shadow-sm placeholder:text-slate-400 focus:border-sky-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>
      <div>
        <%= f.label :schedule_scope, "予定条件", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.select :schedule_scope, options_for_select(schedule_scope_options, @filters[:schedule_scope]), {}, class: "mt-1 w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm shadow-sm placeholder:text-slate-400 focus:border-sky-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>
      <div>
        <%= f.label :as_of, "基準日", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.date_field :as_of, value: @filters[:as_of], class: "mt-1 w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm shadow-sm placeholder:text-slate-400 focus:border-sky-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>
      <div class="flex items-end">
        <%= f.submit "絞り込む", class: "w-full rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      </div>
      <div class="flex items-end">
        <%= link_to "条件をクリア", admin_payment_schedules_path, class: "w-full rounded-lg border border-slate-200 bg-white px-4 py-2 text-center text-sm text-slate-700 hover:bg-slate-50" %>
      </div>
    <% end %>

    <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">対象請求</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @summary[:count] %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">支払予定額</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= money(@summary[:total_amount]) %></div>
      </div>
      <div class="rounded-lg border border-amber-100 bg-amber-50 px-4 py-3">
        <div class="text-xs text-amber-600">本日支払</div>
        <div class="mt-1 text-xl font-semibold text-amber-700"><%= money(@summary[:due_today_amount]) %></div>
      </div>
      <div class="rounded-lg border border-sky-100 bg-sky-50 px-4 py-3">
        <div class="text-xs text-sky-600">7日以内支払</div>
        <div class="mt-1 text-xl font-semibold text-sky-700"><%= money(@summary[:due_within_7_days_amount]) %></div>
      </div>
      <div class="rounded-lg border border-rose-100 bg-rose-50 px-4 py-3">
        <div class="text-xs text-rose-600">滞留額</div>
        <div class="mt-1 text-xl font-semibold text-rose-700"><%= money(@summary[:overdue_amount]) %></div>
      </div>
    </div>
  </div>

  <% if @payment_schedule_rows.any? %>
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">取引状態</th>
            <th class="px-4 py-2">仕入先</th>
            <th class="px-4 py-2">請求番号</th>
            <th class="px-4 py-2">請求日</th>
            <th class="px-4 py-2">支払予定日</th>
            <th class="px-4 py-2">予定状態</th>
            <th class="px-4 py-2">日数</th>
            <th class="px-4 py-2 text-right">支払予定額</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @payment_schedule_rows.each do |row| %>
            <% purchase_bill = row[:purchase_bill] %>
            <% supplier = row[:supplier] %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2"><%= supplier_status_badge(supplier) %></td>
              <td class="px-4 py-2 text-slate-700">
                <div class="font-semibold text-slate-900"><%= supplier.name %></div>
                <div class="text-xs text-slate-500"><%= supplier.code %></div>
              </td>
              <td class="px-4 py-2 font-semibold text-slate-900"><%= link_to purchase_bill.bill_number, admin_purchase_bill_path(purchase_bill), class: "hover:underline" %></td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(purchase_bill.bill_date) %></td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(row[:due_date]) %></td>
              <td class="px-4 py-2"><%= schedule_status_badge(row[:due_date], as_of: @filters[:as_of]) %></td>
              <td class="px-4 py-2 text-slate-700"><%= schedule_days_label(row[:days_delta]) %></td>
              <td class="px-4 py-2 text-right font-semibold text-slate-900"><%= money(row[:outstanding_amount]) %></td>
              <td class="px-4 py-2 text-right">
                <div class="inline-flex gap-2">
                  <%= link_to "請求詳細", admin_purchase_bill_path(purchase_bill), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
                  <%= link_to "仕入先詳細", admin_supplier_path(supplier), class: "rounded border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "shared/pagy", pagy: @pagy %>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <p>条件に一致する支払予定はありません。</p>
    </div>
  <% end %>
</div>
