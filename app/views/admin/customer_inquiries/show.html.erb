<% content_for :page_title, "問い合わせ詳細" %>

<div class="space-y-4">
  <div class="flex items-start justify-between gap-3">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-xl font-semibold text-slate-900"><%= @customer_inquiry.subject %></h1>
        <%= customer_inquiry_status_badge(@customer_inquiry) %>
      </div>
      <p class="text-sm text-slate-600"><%= @customer_inquiry.inquiry_number %> / 受付日 <%= jp_date(@customer_inquiry.inquiry_date) %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if @customer_inquiry.customer.present? && can?("admin.customer_opportunities.create") %>
        <%= link_to "商談を登録", new_admin_customer_opportunity_path(inquiry_id: @customer_inquiry.id, customer_id: @customer_inquiry.customer_id), class: "rounded border border-indigo-200 bg-indigo-50 px-3 py-2 text-sm font-semibold text-indigo-700 hover:bg-indigo-100" %>
      <% elsif can?("admin.customers.create") %>
        <%= link_to "得意先を作成", new_admin_customer_path(customer: { name: @customer_inquiry.company_name, email: @customer_inquiry.contact_email, tel: @customer_inquiry.contact_tel, contact_person_name: @customer_inquiry.contact_person_name, contact_person_department: @customer_inquiry.contact_person_department, contact_person_email: @customer_inquiry.contact_email, contact_person_tel: @customer_inquiry.contact_tel, note: @customer_inquiry.details }), class: "rounded border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-100" %>
      <% end %>
      <% if can?("admin.customer_inquiries.update") %>
        <%= link_to "編集", edit_admin_customer_inquiry_path(@customer_inquiry), class: "rounded border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
      <% end %>
      <%= link_to "一覧へ戻る", admin_customer_inquiries_path, class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">流入経路</div>
      <div class="mt-2 text-xl font-semibold text-slate-900"><%= customer_inquiry_source_label(@customer_inquiry.source) %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">担当者</div>
      <div class="mt-2 text-xl font-semibold text-slate-900"><%= @customer_inquiry.assigned_user&.name || "未割当" %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">初回対応期限</div>
      <div class="mt-2 text-xl font-semibold text-slate-900"><%= jp_date(@customer_inquiry.response_due_date) %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">関連商談</div>
      <div class="mt-2 text-xl font-semibold text-slate-900"><%= @customer_inquiry.customer_opportunities.count %> 件</div>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-900">問い合わせ元</h2>
      <dl class="mt-3 space-y-3 text-sm text-slate-800">
        <div>
          <dt class="text-xs text-slate-500">得意先</dt>
          <dd>
            <% if @customer_inquiry.customer.present? %>
              <%= link_to @customer_inquiry.customer.name, admin_customer_path(@customer_inquiry.customer), class: "text-sky-700 hover:underline" %>
            <% else %>
              <%= @customer_inquiry.company_label %>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">担当者</dt>
          <dd><%= @customer_inquiry.primary_contact.presence || "-" %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">メールアドレス</dt>
          <dd><%= @customer_inquiry.contact_email.presence || "-" %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">電話番号</dt>
          <dd><%= @customer_inquiry.contact_tel.presence || "-" %></dd>
        </div>
      </dl>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-900">内容</h2>
      <div class="mt-3 rounded-lg border border-slate-100 bg-slate-50 px-4 py-3 text-sm text-slate-700">
        <%= simple_format(@customer_inquiry.details.presence || "内容は未入力です。") %>
      </div>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between gap-3">
      <h2 class="text-sm font-semibold text-slate-900">関連商談</h2>
      <% if @customer_inquiry.customer.present? && can?("admin.customer_opportunities.create") %>
        <%= link_to "商談を登録", new_admin_customer_opportunity_path(inquiry_id: @customer_inquiry.id, customer_id: @customer_inquiry.customer_id), class: "text-xs font-semibold text-sky-700 hover:underline" %>
      <% end %>
    </div>
    <% if @opportunities.any? %>
      <div class="mt-3 space-y-2">
        <% @opportunities.each do |opportunity| %>
          <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3 text-sm">
            <div class="flex items-center justify-between gap-3">
              <div>
                <div class="font-semibold text-slate-900"><%= link_to opportunity.subject, admin_customer_opportunity_path(opportunity), class: "hover:underline" %></div>
                <div class="text-xs text-slate-500"><%= opportunity.opportunity_number %> / 予定 <%= money(opportunity.expected_amount) %></div>
              </div>
              <%= customer_opportunity_stage_badge(opportunity) %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="mt-3 text-sm text-slate-500">まだ関連する商談はありません。</p>
    <% end %>
  </div>
</div>
