<% content_for :page_title, "在庫移動詳細" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-xl font-semibold text-slate-900"><%= stock_movement_label(@movement.movement_type) %></h1>
        <%= stock_movement_badge(@movement) %>
      </div>
      <p class="text-sm text-slate-600"><%= @movement.product.name %> / <%= @movement.warehouse.name %></p>
    </div>
    <%= link_to "一覧へ戻る", admin_stock_movements_path, class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">移動日</div>
      <div class="mt-2 text-2xl font-bold text-slate-900"><%= jp_date(@movement.occurred_on) %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">増減</div>
      <div class="mt-2 text-2xl font-bold <%= @movement.signed_quantity.negative? ? 'text-rose-700' : 'text-emerald-700' %>"><%= signed_stock_quantity(@movement.signed_quantity) %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">参照元</div>
      <div class="mt-2 text-sm font-semibold text-slate-900"><%= @movement.reference_type.presence || "手動登録" %></div>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900">詳細</h2>
    <dl class="mt-3 space-y-3 text-sm text-slate-800">
      <div>
        <dt class="text-xs text-slate-500">商品</dt>
        <dd><%= @movement.product.name %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">倉庫</dt>
        <dd><%= @movement.warehouse.name %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">メモ</dt>
        <dd><%= @movement.note.presence || "-" %></dd>
      </div>
    </dl>
  </div>
</div>
