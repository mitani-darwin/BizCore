<% content_for :page_title, "仕入先一覧" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">仕入先一覧</h1>
      <p class="text-sm text-slate-600">発注と入荷に利用する仕入先マスタです。</p>
    </div>
    <% if can?("admin.suppliers.create") %>
      <%= link_to "新規仕入先", new_admin_supplier_path, class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
    <% end %>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: admin_suppliers_path, method: :get, local: true, class: "grid gap-3 md:grid-cols-[minmax(0,2fr)_220px_auto_auto]" do |f| %>
      <div>
        <%= f.label :q, "検索", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.text_field :q, value: @filters[:q], placeholder: "コード・仕入先名・担当者・メールで検索", class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :status, "取引状態", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.select :status, options_for_select([["すべて", ""]] + supplier_status_options, @filters[:status]), {}, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      </div>
      <div class="flex items-end">
        <%= f.submit "絞り込む", class: "w-full rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      </div>
      <div class="flex items-end">
        <%= link_to "条件をクリア", admin_suppliers_path, class: "w-full rounded-lg border border-slate-200 bg-white px-4 py-2 text-center text-sm text-slate-700 hover:bg-slate-50" %>
      </div>
    <% end %>

    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">対象仕入先</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @summary[:count] %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">取引中</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @summary[:active_count] %></div>
      </div>
    </div>
  </div>

  <% if @suppliers.any? %>
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">状態</th>
            <th class="px-4 py-2">コード</th>
            <th class="px-4 py-2">仕入先名</th>
            <th class="px-4 py-2">担当者</th>
            <th class="px-4 py-2">支払条件</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @suppliers.each do |supplier| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2"><%= supplier_status_badge(supplier) %></td>
              <td class="px-4 py-2 font-semibold text-slate-900"><%= supplier.code %></td>
              <td class="px-4 py-2 text-slate-700">
                <div class="font-semibold text-slate-900"><%= supplier.name %></div>
                <div class="text-xs text-slate-500"><%= supplier.email.presence || "メール未設定" %></div>
              </td>
              <td class="px-4 py-2 text-slate-700">
                <div><%= supplier.primary_contact.presence || "未設定" %></div>
                <div class="text-xs text-slate-500"><%= supplier.contact_person_email.presence || supplier.contact_person_tel.presence || "-" %></div>
              </td>
              <td class="px-4 py-2 text-slate-700">
                <div><%= supplier.closing_day.present? ? "#{supplier.closing_day}日締め" : "締日未設定" %></div>
                <div class="text-xs text-slate-500"><%= payment_method_label(supplier.payment_method) %> / <%= payment_due_rule_label(supplier.payment_due_rule) %></div>
              </td>
              <td class="px-4 py-2 text-right">
                <div class="inline-flex gap-2">
                  <%= link_to "詳細", admin_supplier_path(supplier), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
                  <% if can?("admin.suppliers.update") %>
                    <%= link_to "編集", edit_admin_supplier_path(supplier), class: "rounded border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "shared/pagy", pagy: @pagy %>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <p><%= @filters[:q].present? || @filters[:status].present? ? "条件に一致する仕入先がありません。" : "仕入先がまだ登録されていません。" %></p>
    </div>
  <% end %>
</div>
