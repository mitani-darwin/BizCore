<%= form_with model: [:admin, expense_report], local: true, class: "space-y-6" do |f| %>
  <% if expense_report.errors.any? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
      <p class="font-semibold">入力内容にエラーがあります。</p>
      <ul class="list-disc pl-5">
        <% expense_report.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :employee_id, "従業員", class: "block text-sm font-medium text-slate-800" %>
      <%= f.collection_select :employee_id, @employee_options, :id, :title, { include_blank: "選択してください" }, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :expensed_on, "支出日", class: "block text-sm font-medium text-slate-800" %>
      <%= f.date_field :expensed_on, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :category, "経費区分", class: "block text-sm font-medium text-slate-800" %>
      <%= f.select :category, options_for_select(expense_category_options, expense_report.category), {}, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :amount, "金額（円）", class: "block text-sm font-medium text-slate-800" %>
      <%= f.number_field :amount, min: 1, step: 1, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
    </div>
  </div>

  <div>
    <%= f.label :description, "内容", class: "block text-sm font-medium text-slate-800" %>
    <%= f.text_area :description, rows: 3, placeholder: "例: 東京駅〜新宿駅 往復交通費", class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
  </div>

  <div>
    <%= f.label :purpose, "目的", class: "block text-sm font-medium text-slate-800" %>
    <%= f.text_area :purpose, rows: 2, placeholder: "例: 〇〇社訪問", class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
  </div>

  <div>
    <%= f.label :note, "備考", class: "block text-sm font-medium text-slate-800" %>
    <%= f.text_area :note, rows: 2, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit "保存する", class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
    <%= link_to "キャンセル", expense_report.persisted? ? admin_expense_report_path(expense_report) : admin_expense_reports_path, class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm text-slate-600 hover:bg-slate-50" %>
  </div>
<% end %>
