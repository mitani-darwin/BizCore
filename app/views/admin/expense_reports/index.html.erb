<% content_for :page_title, "経費精算一覧" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">経費精算一覧</h1>
      <p class="text-sm text-slate-600">従業員からの経費申請を管理・承認します。</p>
    </div>
    <% if can?("admin.expense_reports.create") %>
      <%= link_to "新規経費申請", new_admin_expense_report_path, class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
    <% end %>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: admin_expense_reports_path, method: :get, local: true, class: "grid gap-3 md:grid-cols-[180px_minmax(0,1fr)_180px_auto_auto]" do |f| %>
      <div>
        <%= f.label :month, "対象月", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= month_field_tag :month, @filters[:month], class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :employee_id, "従業員", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.collection_select :employee_id, @employee_options, :id, :title, { include_blank: "すべて" }, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :status, "状態", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.select :status, options_for_select([["すべて", ""]] + expense_status_options, @filters[:status]), {}, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      </div>
      <div class="flex items-end">
        <%= f.submit "表示", class: "w-full rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      </div>
      <div class="flex items-end">
        <%= link_to "条件をクリア", admin_expense_reports_path, class: "w-full rounded-lg border border-slate-200 bg-white px-4 py-2 text-center text-sm text-slate-700 hover:bg-slate-50" %>
      </div>
    <% end %>

    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">申請件数</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @summary[:count] %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">承認待ち</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @summary[:pending_count] %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">承認済み合計</div>
        <div class="mt-1 text-xl font-semibold text-slate-900">¥<%= number_with_delimiter(@summary[:total_amount].to_i) %></div>
      </div>
    </div>
  </div>

  <% if @expense_reports.any? %>
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">状態</th>
            <th class="px-4 py-2">従業員</th>
            <th class="px-4 py-2">支出日</th>
            <th class="px-4 py-2">区分</th>
            <th class="px-4 py-2">内容</th>
            <th class="px-4 py-2 text-right">金額</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @expense_reports.each do |report| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2"><%= expense_status_badge(report) %></td>
              <td class="px-4 py-2">
                <div class="font-semibold text-slate-900"><%= link_to report.employee.name, admin_employee_path(report.employee), class: "hover:underline" %></div>
                <div class="text-xs text-slate-500"><%= report.employee.employee_code %></div>
              </td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(report.expensed_on) %></td>
              <td class="px-4 py-2 text-slate-700"><%= expense_category_label(report.category) %></td>
              <td class="px-4 py-2 text-slate-700"><%= truncate(report.description, length: 40) %></td>
              <td class="px-4 py-2 text-right font-semibold text-slate-900">¥<%= number_with_delimiter(report.amount.to_i) %></td>
              <td class="px-4 py-2 text-right">
                <div class="inline-flex gap-2">
                  <% if can?("admin.expense_reports.read") %>
                    <%= link_to "詳細", admin_expense_report_path(report), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
                  <% end %>
                  <% if can?("admin.expense_reports.update") %>
                    <%= link_to "編集", edit_admin_expense_report_path(report), class: "rounded border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "shared/pagy", pagy: @pagy %>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <p>対象の経費申請はありません。</p>
    </div>
  <% end %>
</div>
