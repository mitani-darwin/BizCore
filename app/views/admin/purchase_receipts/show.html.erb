<% content_for :page_title, "入荷詳細" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-xl font-semibold text-slate-900"><%= @purchase_receipt.purchase_receipt_number %></h1>
        <%= purchase_receipt_status_badge(@purchase_receipt) %>
      </div>
      <p class="text-sm text-slate-600"><%= @purchase_receipt.supplier.name %> / 入荷日 <%= jp_date(@purchase_receipt.received_on) %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "発注へ", admin_purchase_order_path(@purchase_receipt.purchase_order), class: "rounded border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
      <%= link_to "一覧へ戻る", admin_purchase_receipts_path, class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">入荷金額</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= money(@purchase_receipt.total_amount) %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">返品金額</div>
      <div class="mt-2 text-3xl font-bold text-rose-700"><%= @purchase_receipt.total_return_amount.positive? ? "-#{money(@purchase_receipt.total_return_amount)}" : money(0) %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">値引金額</div>
      <div class="mt-2 text-3xl font-bold text-amber-700"><%= @purchase_receipt.total_discount_amount.positive? ? "-#{money(@purchase_receipt.total_discount_amount)}" : money(0) %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">調整後金額</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= money(@purchase_receipt.net_amount) %></div>
      <div class="mt-2 text-xs text-slate-500">登録日時 <%= @purchase_receipt.issued_at.present? ? @purchase_receipt.issued_at.strftime("%Y/%m/%d %H:%M") : "-" %></div>
    </div>
  </div>

  <div class="grid gap-4 xl:grid-cols-[1.2fr_0.8fr]">
    <div class="space-y-4">
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold text-slate-900">入荷情報</h2>
        <dl class="mt-3 space-y-3 text-sm text-slate-800">
          <div>
            <dt class="text-xs text-slate-500">発注番号</dt>
            <dd><%= link_to @purchase_receipt.purchase_order.purchase_order_number, admin_purchase_order_path(@purchase_receipt.purchase_order), class: "text-sky-700 hover:underline" %></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">倉庫</dt>
            <dd><%= @purchase_receipt.warehouse.name %></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">入荷担当者</dt>
            <dd><%= @purchase_receipt.received_by_name.presence || "-" %></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">備考</dt>
            <dd><%= @purchase_receipt.remarks.presence || "-" %></dd>
          </div>
        </dl>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-4 py-3">
          <h2 class="text-sm font-semibold text-slate-900">入荷明細</h2>
        </div>
        <table class="min-w-full text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-4 py-2">商品</th>
              <th class="px-4 py-2">入荷数量</th>
              <th class="px-4 py-2">返品済</th>
              <th class="px-4 py-2">返品可能</th>
              <th class="px-4 py-2">単価</th>
              <th class="px-4 py-2">金額</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @purchase_receipt.purchase_receipt_items.each do |item| %>
              <tr>
                <td class="px-4 py-2 text-slate-700">
                  <div class="font-semibold text-slate-900"><%= item.product_name_snapshot %></div>
                  <div class="text-xs text-slate-500"><%= item.product_code_snapshot %></div>
                </td>
                <td class="px-4 py-2 text-slate-700"><%= item.received_quantity %> <%= item.unit_name_snapshot %></td>
                <td class="px-4 py-2 text-slate-700"><%= item.returned_quantity %></td>
                <td class="px-4 py-2 text-slate-700"><%= item.returnable_quantity %></td>
                <td class="px-4 py-2 text-slate-700"><%= money(item.unit_cost) %></td>
                <td class="px-4 py-2 text-slate-700"><%= money(item.amount) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold text-slate-900">返品/値引き履歴</h2>
          <% if @purchase_adjustments.any? %>
            <%= link_to "一覧へ", admin_purchase_adjustments_path, class: "text-xs font-semibold text-sky-700 hover:underline" %>
          <% end %>
        </div>
        <% if @purchase_adjustments.any? %>
          <div class="mt-3 space-y-2">
            <% @purchase_adjustments.each do |adjustment| %>
              <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3 text-sm">
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <div class="flex items-center gap-2">
                      <%= purchase_adjustment_status_badge(adjustment) %>
                      <%= link_to adjustment.adjustment_number, admin_purchase_adjustment_path(adjustment), class: "font-semibold text-slate-900 hover:underline" %>
                    </div>
                    <div class="mt-1 text-xs text-slate-500">
                      <%= jp_date(adjustment.adjustment_date) %>
                      <% if adjustment.product_name_snapshot.present? %>
                        / <%= adjustment.product_name_snapshot %>
                      <% end %>
                      <% if adjustment.display_quantity.present? %>
                        / 数量 <%= adjustment.display_quantity %>
                      <% end %>
                    </div>
                  </div>
                  <div class="font-semibold <%= adjustment.purchase_return? ? 'text-rose-700' : 'text-amber-700' %>">
                    <%= purchase_adjustment_signed_amount(adjustment) %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="mt-3 text-sm text-slate-500">まだ返品・値引きは登録されていません。</p>
        <% end %>
      </div>
    </div>

    <div class="space-y-4">
      <% if can?("admin.purchase_adjustments.create") %>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-semibold text-slate-900">返品を登録</h2>
          <% if @returnable_receipt_items.any? %>
            <%= form_with url: admin_purchase_adjustments_path, method: :post, local: true, class: "mt-3 space-y-3" do %>
              <%= hidden_field_tag "purchase_adjustment[purchase_receipt_id]", @purchase_receipt.id %>
              <%= hidden_field_tag "purchase_adjustment[adjustment_type]", "purchase_return" %>
              <div>
                <label class="block text-xs font-semibold text-slate-700">対象商品</label>
                <%= select_tag "purchase_adjustment[purchase_receipt_item_id]", options_from_collection_for_select(@returnable_receipt_items, :id, ->(item) { purchase_receipt_item_return_option_label(item) }), prompt: "選択してください", class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
              </div>
              <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div>
                  <label class="block text-xs font-semibold text-slate-700">返品日</label>
                  <%= date_field_tag "purchase_adjustment[adjustment_date]", Date.current, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-700">返品数量</label>
                  <%= number_field_tag "purchase_adjustment[quantity]", nil, min: 1, step: 1, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
                </div>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700">担当者</label>
                <%= text_field_tag "purchase_adjustment[processed_by_name]", nil, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700">理由</label>
                <%= text_area_tag "purchase_adjustment[reason]", nil, rows: 3, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
              </div>
              <%= submit_tag "返品を登録", class: "rounded bg-rose-600 px-3 py-2 text-sm font-semibold text-white hover:bg-rose-700" %>
            <% end %>
          <% else %>
            <p class="mt-3 text-sm text-slate-500">返品可能な入荷明細はありません。</p>
          <% end %>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-semibold text-slate-900">値引きを登録</h2>
          <%= form_with url: admin_purchase_adjustments_path, method: :post, local: true, class: "mt-3 space-y-3" do %>
            <%= hidden_field_tag "purchase_adjustment[purchase_receipt_id]", @purchase_receipt.id %>
            <%= hidden_field_tag "purchase_adjustment[adjustment_type]", "discount" %>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <div>
                <label class="block text-xs font-semibold text-slate-700">値引日</label>
                <%= date_field_tag "purchase_adjustment[adjustment_date]", Date.current, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700">値引金額</label>
                <%= number_field_tag "purchase_adjustment[amount]", nil, min: 1, step: 1, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
              </div>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700">担当者</label>
              <%= text_field_tag "purchase_adjustment[processed_by_name]", nil, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700">理由</label>
              <%= text_area_tag "purchase_adjustment[reason]", nil, rows: 3, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
            </div>
            <%= submit_tag "値引きを登録", class: "rounded bg-amber-500 px-3 py-2 text-sm font-semibold text-white hover:bg-amber-600" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
