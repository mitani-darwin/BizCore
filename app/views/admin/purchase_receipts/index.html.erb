<% content_for :page_title, "入荷一覧" %>

<div class="space-y-4">
  <div>
    <h1 class="text-xl font-semibold text-slate-900">入荷一覧</h1>
    <p class="text-sm text-slate-600">発注に対して登録された入荷履歴です。</p>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: admin_purchase_receipts_path, method: :get, local: true, class: "grid gap-3 lg:grid-cols-[minmax(0,2fr)_240px_auto_auto]" do |f| %>
      <div>
        <%= f.label :q, "検索", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.text_field :q, value: @filters[:q], placeholder: "入荷番号・発注番号・仕入先・担当者で検索", class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :supplier_id, "仕入先", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.collection_select :supplier_id, @supplier_filter_options, :id, :name, { include_blank: "すべて", selected: @filters[:supplier_id] }, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      </div>
      <div class="flex items-end">
        <%= f.submit "絞り込む", class: "w-full rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      </div>
      <div class="flex items-end">
        <%= link_to "条件をクリア", admin_purchase_receipts_path, class: "w-full rounded-lg border border-slate-200 bg-white px-4 py-2 text-center text-sm text-slate-700 hover:bg-slate-50" %>
      </div>
    <% end %>

    <div class="mt-4 grid gap-3 md:grid-cols-3">
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">対象入荷</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @summary[:count] %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">本日入荷</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @summary[:today_count] %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">対象金額合計</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= money(@summary[:amount_total]) %></div>
      </div>
    </div>
  </div>

  <% if @purchase_receipts.any? %>
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">入荷番号</th>
            <th class="px-4 py-2">仕入先</th>
            <th class="px-4 py-2">倉庫</th>
            <th class="px-4 py-2">発注番号</th>
            <th class="px-4 py-2">入荷日</th>
            <th class="px-4 py-2">金額</th>
            <th class="px-4 py-2">状態</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @purchase_receipts.each do |receipt| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2 font-semibold text-slate-900"><%= receipt.purchase_receipt_number %></td>
              <td class="px-4 py-2 text-slate-700"><%= receipt.supplier.name %></td>
              <td class="px-4 py-2 text-slate-700"><%= receipt.warehouse.name %></td>
              <td class="px-4 py-2 text-slate-700"><%= link_to receipt.purchase_order.purchase_order_number, admin_purchase_order_path(receipt.purchase_order), class: "hover:underline" %></td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(receipt.received_on) %></td>
              <td class="px-4 py-2 text-slate-700"><%= money(receipt.total_amount) %></td>
              <td class="px-4 py-2"><%= purchase_receipt_status_badge(receipt) %></td>
              <td class="px-4 py-2 text-right">
                <%= link_to "詳細", admin_purchase_receipt_path(receipt), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <p><%= @filters[:q].present? || @filters[:supplier_id].present? ? "条件に一致する入荷がありません。" : "入荷がまだ登録されていません。" %></p>
    </div>
  <% end %>
</div>
