<% content_for :page_title, "ダッシュボード" %>

<div class="space-y-6">

  <%# ── オンボーディング ──────────────────────────────────────────────── %>
  <% visible_steps = @onboarding_steps.select { |step| step[:permission_key].blank? || can?(step[:permission_key]) } %>
  <% pending_steps = visible_steps.reject { |step| step[:done] } %>
  <% if pending_steps.any? %>
    <% done_count = visible_steps.count { |step| step[:done] } %>
    <% next_step  = pending_steps.find { |step| step[:path].present? } %>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="text-xs font-semibold text-slate-500">初期セットアップ</p>
          <h2 class="text-lg font-semibold text-slate-900">最初にやること</h2>
          <p class="mt-1 text-sm text-slate-600">迷わず始められるよう、必要最低限だけに絞っています。</p>
        </div>
        <div class="text-right text-xs text-slate-500">
          <div class="text-lg font-semibold text-slate-900"><%= done_count %>/<%= visible_steps.size %></div>
          <div>完了</div>
          <% if next_step %>
            <%= link_to "次に進む", next_step[:path], class: "mt-2 inline-flex items-center rounded-full bg-slate-900 px-3 py-1 text-[11px] font-semibold text-white hover:bg-slate-800" %>
          <% end %>
        </div>
      </div>
      <div class="mt-4 space-y-2">
        <% visible_steps.each do |step| %>
          <div class="flex items-center justify-between rounded-lg border border-slate-100 px-3 py-2">
            <div class="flex items-center gap-2">
              <% if step[:done] %>
                <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-50 text-emerald-600 text-xs font-bold">✓</span>
              <% else %>
                <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-slate-500 text-xs font-bold"><%= visible_steps.index(step) + 1 %></span>
              <% end %>
              <span class="text-sm text-slate-800"><%= step[:label] %></span>
            </div>
            <% if step[:done] %>
              <span class="text-xs font-semibold text-emerald-700">完了</span>
            <% elsif step[:path].present? %>
              <%= link_to "実行する", step[:path], class: "rounded-md border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50" %>
            <% else %>
              <span class="text-xs text-slate-400">権限なし</span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ── KPI カード ──────────────────────────────────────────────────────── %>
  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

    <% if @kpi[:monthly_sales] %>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-semibold text-slate-500">今月の請求金額</p>
        <p class="mt-2 text-2xl font-bold text-slate-900">¥<%= number_with_delimiter(@kpi[:monthly_sales].to_i) %></p>
        <p class="mt-1 text-xs text-slate-400"><%= Date.current.strftime("%-m月分") %></p>
        <%= link_to "請求一覧へ", admin_invoices_path, class: "mt-2 inline-block text-xs font-semibold text-sky-600 hover:underline" %>
      </div>
    <% end %>

    <% if @kpi[:receivable_balance] %>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-semibold text-slate-500">売掛残高</p>
        <p class="mt-2 text-2xl font-bold text-<%= @kpi[:receivable_balance] > 0 ? "amber-600" : "slate-900" %>">¥<%= number_with_delimiter(@kpi[:receivable_balance].to_i) %></p>
        <p class="mt-1 text-xs text-slate-400">未回収合計</p>
        <%= link_to "売掛残高へ", admin_receivables_path, class: "mt-2 inline-block text-xs font-semibold text-sky-600 hover:underline" %>
      </div>
    <% end %>

    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-semibold text-slate-500">承認待ち申請</p>
      <p class="mt-2 text-2xl font-bold text-<%= @kpi[:pending_approvals] > 0 ? "rose-600" : "slate-900" %>">
        <%= @kpi[:pending_approvals] %><span class="text-base font-normal text-slate-500 ml-1">件</span>
      </p>
      <p class="mt-1 text-xs text-slate-400">有給 + 経費</p>
      <% if can?("admin.leave_requests.read") %>
        <%= link_to "有給一覧へ", admin_leave_requests_path, class: "mt-2 inline-block text-xs font-semibold text-sky-600 hover:underline" %>
      <% end %>
    </div>

    <% if @kpi[:working_employees] %>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-semibold text-slate-500">現在出勤中</p>
        <p class="mt-2 text-2xl font-bold text-slate-900">
          <%= @kpi[:working_employees] %><span class="text-base font-normal text-slate-500 ml-1">名</span>
        </p>
        <p class="mt-1 text-xs text-slate-400">リアルタイム</p>
        <%= link_to "勤怠一覧へ", admin_attendance_records_path, class: "mt-2 inline-block text-xs font-semibold text-sky-600 hover:underline" %>
      </div>
    <% end %>

  </div>

  <%# ── 承認待ち一覧 ────────────────────────────────────────────────────── %>
  <% if @pending_leave_requests.any? || @pending_expense_reports.any? %>
    <div class="grid gap-4 md:grid-cols-2">

      <% if @pending_leave_requests.any? %>
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-5 shadow-sm">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-semibold text-amber-900">有給申請（承認待ち）</h2>
            <%= link_to "すべて見る", admin_leave_requests_path(status: "pending"), class: "text-xs font-semibold text-amber-700 hover:underline" %>
          </div>
          <div class="mt-3 space-y-2">
            <% @pending_leave_requests.each do |req| %>
              <div class="flex items-center justify-between rounded-lg border border-amber-100 bg-white px-3 py-2">
                <div>
                  <div class="text-sm font-medium text-slate-800"><%= req.employee.name %></div>
                  <div class="text-xs text-slate-500">
                    <%= req.start_date.strftime("%m/%d") %> 〜 <%= req.end_date.strftime("%m/%d") %>（<%= req.days_count %>日）
                  </div>
                </div>
                <%= link_to "確認", admin_leave_request_path(req), class: "rounded-md border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800 hover:bg-amber-100" %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @pending_expense_reports.any? %>
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-5 shadow-sm">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-semibold text-amber-900">経費精算（承認待ち）</h2>
            <%= link_to "すべて見る", admin_expense_reports_path(status: "pending"), class: "text-xs font-semibold text-amber-700 hover:underline" %>
          </div>
          <div class="mt-3 space-y-2">
            <% @pending_expense_reports.each do |rep| %>
              <div class="flex items-center justify-between rounded-lg border border-amber-100 bg-white px-3 py-2">
                <div>
                  <div class="text-sm font-medium text-slate-800"><%= rep.employee.name %></div>
                  <div class="text-xs text-slate-500">
                    <%= rep.expensed_on.strftime("%m/%d") %> ¥<%= number_with_delimiter(rep.amount.to_i) %>
                  </div>
                </div>
                <%= link_to "確認", admin_expense_report_path(rep), class: "rounded-md border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800 hover:bg-amber-100" %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>
  <% end %>

  <%# ── アラート ────────────────────────────────────────────────────────── %>
  <% if @low_stock_items.any? || @expiring_contracts.any? %>
    <div class="grid gap-4 md:grid-cols-2">

      <% if @low_stock_items.any? %>
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-5 shadow-sm">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-semibold text-rose-900">在庫アラート</h2>
            <%= link_to "在庫一覧へ", admin_stock_items_path, class: "text-xs font-semibold text-rose-700 hover:underline" %>
          </div>
          <p class="mt-1 text-xs text-rose-700">安全在庫を下回っている商品があります</p>
          <div class="mt-3 space-y-2">
            <% @low_stock_items.each do |item| %>
              <div class="flex items-center justify-between rounded-lg border border-rose-100 bg-white px-3 py-2">
                <div>
                  <div class="text-sm font-medium text-slate-800"><%= item.product.name %></div>
                  <div class="text-xs text-slate-500"><%= item.warehouse.name %></div>
                </div>
                <div class="text-right">
                  <div class="text-sm font-bold text-rose-600"><%= item.available_quantity %><span class="text-xs font-normal text-slate-500 ml-1">在庫</span></div>
                  <div class="text-xs text-slate-400">安全在庫 <%= item.safety_stock %></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @expiring_contracts.any? %>
        <div class="rounded-xl border border-orange-200 bg-orange-50 p-5 shadow-sm">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-semibold text-orange-900">契約期限アラート</h2>
            <%= link_to "契約一覧へ", admin_contracts_path, class: "text-xs font-semibold text-orange-700 hover:underline" %>
          </div>
          <p class="mt-1 text-xs text-orange-700">30日以内に期限を迎える契約があります</p>
          <div class="mt-3 space-y-2">
            <% @expiring_contracts.each do |contract| %>
              <div class="flex items-center justify-between rounded-lg border border-orange-100 bg-white px-3 py-2">
                <div>
                  <div class="text-sm font-medium text-slate-800"><%= contract.title %></div>
                  <div class="text-xs text-slate-500"><%= contract.counterparty_name %></div>
                </div>
                <div class="text-right">
                  <div class="text-sm font-bold text-orange-600"><%= contract.ended_on.strftime("%m/%d") %></div>
                  <div class="text-xs text-slate-400">残 <%= contract.days_until_expiry %>日</div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>
  <% end %>

  <%# ── 最近の操作 ──────────────────────────────────────────────────────── %>
  <% if can?("admin.audit_logs.read") %>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-slate-800">最近の操作</h2>
        <%= link_to "監査ログへ", admin_audit_logs_path, class: "text-xs font-semibold text-sky-700 hover:underline" %>
      </div>
      <% if @recent_audit_logs.any? %>
        <div class="mt-3 space-y-2 text-sm">
          <% @recent_audit_logs.each do |log| %>
            <div class="flex items-center justify-between rounded-lg border border-slate-100 px-3 py-2">
              <div>
                <div class="text-xs text-slate-500"><%= l log.created_at, format: :short %></div>
                <div class="text-sm text-slate-800"><%= log.action_key %></div>
              </div>
              <div class="text-right">
                <div class="text-[11px] text-slate-500"><%= log.actor&.try(:name) || "System" %></div>
                <% status_color = log.status == "succeeded" ? "emerald" : log.status == "denied" ? "amber" : "rose" %>
                <span class="text-[10px] font-semibold text-<%= status_color %>-600"><%= log.status %></span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="mt-3 rounded-lg border border-dashed border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600">
          まだ操作履歴がありません。最初の更新を行うとここに表示されます。
        </div>
      <% end %>
    </div>
  <% end %>

</div>
