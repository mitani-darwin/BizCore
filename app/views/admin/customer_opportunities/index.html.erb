<% content_for :page_title, "商談一覧" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">商談一覧</h1>
      <p class="text-sm text-slate-600">商談内容、見込金額、進捗ステージを管理します。</p>
    </div>
    <% if can?("admin.customer_opportunities.create") %>
      <%= link_to "新規商談", new_admin_customer_opportunity_path, class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
    <% end %>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: admin_customer_opportunities_path, method: :get, local: true, class: "grid gap-3 md:grid-cols-[minmax(0,2fr)_200px_240px_auto_auto]" do |f| %>
      <div>
        <%= f.label :q, "検索", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.text_field :q, value: @filters[:q], placeholder: "番号・件名・得意先名で検索", class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :stage, "ステージ", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.select :stage, options_for_select([["すべて", ""]] + customer_opportunity_stage_options, @filters[:stage]), {}, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :customer_id, "得意先", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.select :customer_id, options_from_collection_for_select(@customer_filter_options, :id, :name, @filters[:customer_id]), { include_blank: "すべて" }, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      </div>
      <div class="flex items-end">
        <%= f.submit "絞り込む", class: "w-full rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      </div>
      <div class="flex items-end">
        <%= link_to "条件をクリア", admin_customer_opportunities_path, class: "w-full rounded-lg border border-slate-200 bg-white px-4 py-2 text-center text-sm text-slate-700 hover:bg-slate-50" %>
      </div>
    <% end %>

    <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">対象件数</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @summary[:count] %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">進行中</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @summary[:open_count] %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">商談見込</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= money(@summary[:pipeline_amount]) %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">受注済売上</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= money(@summary[:won_amount]) %></div>
      </div>
    </div>
  </div>

  <% if @customer_opportunities.any? %>
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">ステージ</th>
            <th class="px-4 py-2">開始日</th>
            <th class="px-4 py-2">商談</th>
            <th class="px-4 py-2">得意先</th>
            <th class="px-4 py-2">受注予定</th>
            <th class="px-4 py-2 text-right">見込金額</th>
            <th class="px-4 py-2 text-right">受注確度</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @customer_opportunities.each do |opportunity| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2"><%= customer_opportunity_stage_badge(opportunity) %></td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(opportunity.opened_on) %></td>
              <td class="px-4 py-2 text-slate-700">
                <div class="font-semibold text-slate-900"><%= opportunity.subject %></div>
                <div class="text-xs text-slate-500"><%= opportunity.opportunity_number %></div>
              </td>
              <td class="px-4 py-2 text-slate-700"><%= opportunity.customer.name %></td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(opportunity.expected_close_on) %></td>
              <td class="px-4 py-2 text-right text-slate-700"><%= money(opportunity.expected_amount) %></td>
              <td class="px-4 py-2 text-right text-slate-700"><%= opportunity.probability %>%</td>
              <td class="px-4 py-2 text-right">
                <div class="inline-flex gap-2">
                  <%= link_to "詳細", admin_customer_opportunity_path(opportunity), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
                  <% if can?("admin.customer_opportunities.update") %>
                    <%= link_to "編集", edit_admin_customer_opportunity_path(opportunity), class: "rounded border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "shared/pagy", pagy: @pagy %>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <p>条件に一致する商談はありません。</p>
    </div>
  <% end %>
</div>
