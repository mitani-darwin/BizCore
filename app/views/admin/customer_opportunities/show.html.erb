<% content_for :page_title, "商談詳細" %>

<div class="space-y-4">
  <div class="flex items-start justify-between gap-3">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-xl font-semibold text-slate-900"><%= @customer_opportunity.subject %></h1>
        <%= customer_opportunity_stage_badge(@customer_opportunity) %>
      </div>
      <p class="text-sm text-slate-600"><%= @customer_opportunity.opportunity_number %> / 開始日 <%= jp_date(@customer_opportunity.opened_on) %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if can?("admin.quotations.create") %>
        <%= link_to "見積を作成", new_admin_quotation_path(customer_id: @customer_opportunity.customer_id), class: "rounded border border-indigo-200 bg-indigo-50 px-3 py-2 text-sm font-semibold text-indigo-700 hover:bg-indigo-100" %>
      <% end %>
      <% if can?("admin.customer_opportunities.update") %>
        <%= link_to "編集", edit_admin_customer_opportunity_path(@customer_opportunity), class: "rounded border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
      <% end %>
      <%= link_to "一覧へ戻る", admin_customer_opportunities_path, class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">見込金額</div>
      <div class="mt-2 text-2xl font-semibold text-slate-900"><%= money(@customer_opportunity.expected_amount) %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">確度加重見込</div>
      <div class="mt-2 text-2xl font-semibold text-slate-900"><%= money(@customer_opportunity.weighted_expected_amount) %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">受注確度</div>
      <div class="mt-2 text-2xl font-semibold text-slate-900"><%= @customer_opportunity.probability %>%</div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">実売上</div>
      <div class="mt-2 text-2xl font-semibold text-slate-900"><%= money(@customer_opportunity.actual_sales_amount) %></div>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-900">基本情報</h2>
      <dl class="mt-3 space-y-3 text-sm text-slate-800">
        <div>
          <dt class="text-xs text-slate-500">得意先</dt>
          <dd><%= link_to @customer_opportunity.customer.name, admin_customer_path(@customer_opportunity.customer), class: "text-sky-700 hover:underline" %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">担当者</dt>
          <dd><%= @customer_opportunity.assigned_user&.name || "未割当" %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">受注予定日</dt>
          <dd><%= jp_date(@customer_opportunity.expected_close_on) %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">確定日</dt>
          <dd><%= jp_date(@customer_opportunity.closed_on) %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">元問い合わせ</dt>
          <dd>
            <% if @customer_opportunity.customer_inquiry.present? %>
              <%= link_to @customer_opportunity.customer_inquiry.subject, admin_customer_inquiry_path(@customer_opportunity.customer_inquiry), class: "text-sky-700 hover:underline" %>
            <% else %>
              -
            <% end %>
          </dd>
        </div>
      </dl>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-900">次回アクション</h2>
      <div class="mt-3 rounded-lg border border-slate-100 bg-slate-50 px-4 py-3 text-sm text-slate-700">
        <%= simple_format(@customer_opportunity.next_action.presence || "未設定") %>
      </div>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900">商談内容</h2>
    <div class="mt-3 rounded-lg border border-slate-100 bg-slate-50 px-4 py-3 text-sm text-slate-700">
      <%= simple_format(@customer_opportunity.summary.presence || "内容は未入力です。") %>
    </div>
  </div>
</div>
