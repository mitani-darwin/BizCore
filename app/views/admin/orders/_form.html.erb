<%= form_with model: [:admin, order], local: true, class: "space-y-6" do |f| %>
  <% if order.errors.any? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
      <p class="font-semibold">入力内容にエラーがあります。</p>
      <ul class="list-disc pl-5">
        <% order.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @customer_options.blank? || @product_options.blank? %>
    <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
      注文を作成するには、先に得意先と商品を登録してください。
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :customer_id, "得意先", class: "block text-sm font-medium text-slate-800" %>
      <%= f.collection_select :customer_id, @customer_options, :id, :name, { include_blank: "選択してください" }, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500", required: true %>
    </div>
    <div>
      <%= f.label :ordered_by_name, "先方担当者", class: "block text-sm font-medium text-slate-800" %>
      <%= f.text_field :ordered_by_name, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
    </div>
    <div>
      <%= f.label :order_date, "注文日", class: "block text-sm font-medium text-slate-800" %>
      <%= f.date_field :order_date, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500", required: true %>
    </div>
    <div>
      <%= f.label :requested_delivery_date, "希望納期", class: "block text-sm font-medium text-slate-800" %>
      <%= f.date_field :requested_delivery_date, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
    </div>
    <div class="sm:col-span-2">
      <%= f.label :delivery_address, "納品先住所", class: "block text-sm font-medium text-slate-800" %>
      <%= f.text_field :delivery_address, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
    </div>
    <div class="sm:col-span-2">
      <%= f.label :remarks, "備考", class: "block text-sm font-medium text-slate-800" %>
      <%= f.text_area :remarks, rows: 3, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-sm font-semibold text-slate-900">注文明細</h2>
        <p class="text-xs text-slate-500">空行は保存時に無視されます。</p>
      </div>
    </div>

    <div class="mt-3 overflow-x-auto rounded-lg border border-slate-200 bg-white">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-3 py-2">商品</th>
            <th class="px-3 py-2">数量</th>
            <th class="px-3 py-2">単価</th>
            <th class="px-3 py-2">金額</th>
            <th class="px-3 py-2">削除</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <%= f.fields_for :order_items do |item_form| %>
            <% item = item_form.object %>
            <tr>
              <td class="px-3 py-2">
                <%= item_form.hidden_field :id if item.persisted? %>
                <%= item_form.collection_select :product_id, @product_options, :id, :name, { include_blank: "選択してください" }, class: "w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
              </td>
              <td class="px-3 py-2">
                <%= item_form.number_field :quantity, min: 1, step: 1, class: "w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
              </td>
              <td class="px-3 py-2">
                <%= item_form.number_field :unit_price, min: 0, step: 1, class: "w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
              </td>
              <td class="px-3 py-2 text-slate-700">
                <%= item.amount.to_d.positive? ? money(item.amount) : "-" %>
              </td>
              <td class="px-3 py-2">
                <% if item.persisted? %>
                  <label class="inline-flex items-center gap-2 text-xs text-slate-600">
                    <%= item_form.check_box :_destroy, class: "h-4 w-4 rounded border-slate-300 text-rose-600 focus:ring-rose-500" %>
                    削除
                  </label>
                <% else %>
                  <span class="text-slate-400">-</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit "保存する", class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
    <%= link_to "キャンセル", order.persisted? ? admin_order_path(order) : admin_orders_path, class: "text-sm text-slate-600 hover:text-slate-800" %>
  </div>
<% end %>
