<% content_for :page_title, "注文詳細" %>

<div class="space-y-4">
  <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-xl font-semibold text-slate-900"><%= @order.order_number %></h1>
        <%= order_status_badge(@order) %>
      </div>
      <p class="text-sm text-slate-600"><%= @order.customer.name %> / 注文日 <%= jp_date(@order.order_date) %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Excel出力", download_excel_admin_order_path(@order), class: "rounded border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-100" %>
      <% if can?("admin.orders.update") && @order.draft? %>
        <%= link_to "編集", edit_admin_order_path(@order), class: "rounded border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
        <%= button_to "注文書を送信", send_order_admin_order_path(@order), method: :patch, class: "rounded bg-sky-600 px-3 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      <% end %>
      <% if can?("admin.orders.update") && @order.sent? %>
        <%= button_to "受注を確定", accept_order_admin_order_path(@order), method: :patch, class: "rounded bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-700" %>
      <% end %>
    </div>
  </div>

  <div class="grid gap-4 xl:grid-cols-[1.2fr_0.8fr]">
    <div class="space-y-4">
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold text-slate-900">注文情報</h2>
        <dl class="mt-3 grid gap-4 sm:grid-cols-2 text-sm text-slate-800">
          <div>
            <dt class="text-xs text-slate-500">元見積</dt>
            <dd>
              <% if @order.quotation.present? %>
                <%= link_to @order.quotation.quotation_number, admin_quotation_path(@order.quotation), class: "text-sky-700 hover:underline" %>
              <% else %>
                -
              <% end %>
            </dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">希望納期</dt>
            <dd><%= jp_date(@order.requested_delivery_date) %></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">先方担当者</dt>
            <dd><%= @order.ordered_by_name.presence || "-" %></dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="text-xs text-slate-500">納品先住所</dt>
            <dd><%= @order.delivery_address.presence || "-" %></dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="text-xs text-slate-500">備考</dt>
            <dd><%= @order.remarks.presence || "-" %></dd>
          </div>
        </dl>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-4 py-3">
          <h2 class="text-sm font-semibold text-slate-900">注文明細</h2>
        </div>
        <table class="min-w-full text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-4 py-2">商品</th>
              <th class="px-4 py-2">数量</th>
              <th class="px-4 py-2">単価</th>
              <th class="px-4 py-2">金額</th>
              <th class="px-4 py-2">引当</th>
              <th class="px-4 py-2">納品</th>
              <th class="px-4 py-2">状態</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @order.order_items.each do |item| %>
              <tr>
                <td class="px-4 py-2 text-slate-700">
                  <div class="font-semibold text-slate-900"><%= item.product_name_snapshot %></div>
                  <div class="text-xs text-slate-500"><%= item.product_code_snapshot %></div>
                </td>
                <td class="px-4 py-2 text-slate-700"><%= item.quantity %> <%= item.unit_name_snapshot %></td>
                <td class="px-4 py-2 text-slate-700"><%= money(item.unit_price) %></td>
                <td class="px-4 py-2 text-slate-700"><%= money(item.amount) %></td>
                <td class="px-4 py-2 text-slate-700"><%= item.allocated_quantity %></td>
                <td class="px-4 py-2 text-slate-700"><%= item.delivered_quantity %></td>
                <td class="px-4 py-2 text-slate-700"><%= order_item_status_label(item.status) %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="bg-slate-50">
            <tr>
              <td colspan="3" class="px-4 py-3 text-right text-sm font-semibold text-slate-700">合計</td>
              <td class="px-4 py-3 text-sm font-semibold text-slate-900"><%= money(@order.total_amount) %></td>
              <td colspan="3"></td>
            </tr>
          </tfoot>
        </table>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold text-slate-900">納品履歴</h2>
          <% if @deliveries.any? %>
            <%= link_to "納品一覧へ", admin_deliveries_path, class: "text-xs font-semibold text-sky-700 hover:underline" %>
          <% end %>
        </div>
        <% if @deliveries.any? %>
          <div class="mt-3 space-y-2">
            <% @deliveries.each do |delivery| %>
              <div class="flex items-center justify-between rounded-lg border border-slate-100 px-4 py-3 text-sm">
                <div>
                  <div class="font-semibold text-slate-900"><%= link_to delivery.delivery_number, admin_delivery_path(delivery), class: "hover:underline" %></div>
                  <div class="text-xs text-slate-500">納品日 <%= jp_date(delivery.delivery_date) %></div>
                </div>
                <%= delivery_status_badge(delivery) %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="mt-3 text-sm text-slate-500">まだ納品は発行されていません。</p>
        <% end %>
      </div>
    </div>

    <div class="space-y-4">
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold text-slate-900">進行アクション</h2>
        <div class="mt-3 space-y-3">
          <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
            <div class="text-xs font-semibold text-slate-500">1. 注文書を送る</div>
            <% if can?("admin.orders.update") && @order.draft? %>
              <div class="mt-2">
                <%= button_to "注文書を送信", send_order_admin_order_path(@order), method: :patch, class: "rounded bg-sky-600 px-3 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
              </div>
            <% else %>
              <div class="mt-2 text-sm text-slate-600">現在の状態: <%= order_status_label(@order.status) %></div>
            <% end %>
          </div>

          <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
            <div class="text-xs font-semibold text-slate-500">2. 受注後、在庫を確保</div>
            <% if can?("admin.orders.update") && @order.sent? %>
              <div class="mt-2">
                <%= button_to "受注を確定", accept_order_admin_order_path(@order), method: :patch, class: "rounded bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-700" %>
              </div>
            <% end %>
            <% if can?("admin.orders.update") && (@order.accepted? || @order.allocated?) && @warehouse_options.any? %>
              <%= form_with url: reserve_stock_admin_order_path(@order), method: :patch, local: true, class: "mt-3 space-y-2" do %>
                <div>
                  <label class="block text-xs font-semibold text-slate-700">引当倉庫</label>
                  <%= select_tag :warehouse_id, options_from_collection_for_select(@warehouse_options, :id, :name), include_blank: "選択してください", class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
                </div>
                <%= submit_tag "在庫を確保", class: "rounded bg-amber-500 px-3 py-2 text-sm font-semibold text-white hover:bg-amber-600" %>
              <% end %>
            <% elsif @order.accepted? || @order.allocated? %>
              <p class="mt-2 text-sm text-slate-500">利用できる倉庫がありません。</p>
            <% else %>
              <div class="mt-2 text-sm text-slate-600">受注確定後に在庫確保できます。</div>
            <% end %>
          </div>

          <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
            <div class="text-xs font-semibold text-slate-500">3. 納品書を発行</div>
            <% if can?("admin.orders.update") && @order.allocated? %>
              <%= form_with url: issue_delivery_admin_order_path(@order), method: :patch, local: true, class: "mt-2 space-y-2" do %>
                <div>
                  <label class="block text-xs font-semibold text-slate-700">納品日</label>
                  <%= date_field_tag :delivery_date, Date.current, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
                </div>
                <%= submit_tag "納品書を発行", class: "rounded bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-700" %>
              <% end %>
            <% else %>
              <div class="mt-2 text-sm text-slate-600">在庫確保後に納品書を発行できます。</div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold text-slate-900">進捗サマリ</h2>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
            <div class="text-xs text-slate-500">引当済数量</div>
            <div class="mt-1 text-xl font-semibold text-slate-900"><%= @order.order_items.sum(&:allocated_quantity) %></div>
          </div>
          <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
            <div class="text-xs text-slate-500">納品済数量</div>
            <div class="mt-1 text-xl font-semibold text-slate-900"><%= @order.order_items.sum(&:delivered_quantity) %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="flex gap-2">
    <%= link_to "一覧へ戻る", admin_orders_path, class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
    <% if can?("admin.orders.update") && @order.draft? %>
      <%= link_to "編集", edit_admin_order_path(@order), class: "rounded border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
    <% end %>
  </div>
</div>
