<% content_for :page_title, "注文一覧" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">注文一覧</h1>
      <p class="text-sm text-slate-600">注文書送信から納品・請求までの起点となる伝票です。</p>
    </div>
    <% if can?("admin.orders.create") %>
      <%= link_to "新規注文", new_admin_order_path, class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
    <% end %>
  </div>

  <% if @orders.any? %>
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">注文番号</th>
            <th class="px-4 py-2">得意先</th>
            <th class="px-4 py-2">注文日</th>
            <th class="px-4 py-2">希望納期</th>
            <th class="px-4 py-2">金額</th>
            <th class="px-4 py-2">状態</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @orders.each do |order| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2 font-semibold text-slate-900"><%= order.order_number %></td>
              <td class="px-4 py-2 text-slate-700"><%= order.customer.name %></td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(order.order_date) %></td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(order.requested_delivery_date) %></td>
              <td class="px-4 py-2 text-slate-700"><%= money(order.total_amount) %></td>
              <td class="px-4 py-2"><%= order_status_badge(order) %></td>
              <td class="px-4 py-2 text-right">
                <div class="inline-flex gap-2">
                  <%= link_to "詳細", admin_order_path(order), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
                  <% if can?("admin.orders.update") && order.draft? %>
                    <%= link_to "編集", edit_admin_order_path(order), class: "rounded border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <p>注文がまだ登録されていません。</p>
    </div>
  <% end %>
</div>
