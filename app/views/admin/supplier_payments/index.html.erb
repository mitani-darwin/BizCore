<% content_for :page_title, "支払一覧" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">支払一覧</h1>
      <p class="text-sm text-slate-600">支払登録と仕入請求書への消し込み状況を管理します。</p>
    </div>
    <% if can?("admin.supplier_payments.create") %>
      <%= link_to "支払を登録", new_admin_supplier_payment_path, class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
    <% end %>
  </div>

  <% if @supplier_payments.any? %>
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">支払番号</th>
            <th class="px-4 py-2">仕入先</th>
            <th class="px-4 py-2">支払日</th>
            <th class="px-4 py-2">支払額</th>
            <th class="px-4 py-2">未消込額</th>
            <th class="px-4 py-2">状態</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @supplier_payments.each do |supplier_payment| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2 font-semibold text-slate-900"><%= supplier_payment.payment_number %></td>
              <td class="px-4 py-2 text-slate-700"><%= supplier_payment.supplier.name %></td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(supplier_payment.payment_date) %></td>
              <td class="px-4 py-2 text-slate-700"><%= money(supplier_payment.amount) %></td>
              <td class="px-4 py-2 text-slate-700"><%= money(supplier_payment.unapplied_amount) %></td>
              <td class="px-4 py-2"><%= supplier_payment_status_badge(supplier_payment) %></td>
              <td class="px-4 py-2 text-right">
                <div class="inline-flex gap-2">
                  <%= link_to "詳細", admin_supplier_payment_path(supplier_payment), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
                  <% if can?("admin.supplier_payments.update") %>
                    <%= link_to "編集", edit_admin_supplier_payment_path(supplier_payment), class: "rounded border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <p>支払はまだ登録されていません。</p>
    </div>
  <% end %>
</div>
