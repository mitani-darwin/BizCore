<% content_for :page_title, "請求締め詳細" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-xl font-semibold text-slate-900"><%= @billing_batch.batch_number %></h1>
        <%= billing_batch_status_badge(@billing_batch) %>
      </div>
      <p class="text-sm text-slate-600">締日 <%= jp_date(@billing_batch.closing_date) %> / 請求日 <%= jp_date(@billing_batch.invoice_date) %></p>
    </div>
    <div class="flex gap-2">
      <% if can?("admin.billing_batches.update") && @billing_batch.cancellable? %>
        <%= button_to "締めを解除", cancel_admin_billing_batch_path(@billing_batch), method: :patch, class: "rounded border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-100" %>
      <% end %>
      <%= link_to "一覧へ戻る", admin_billing_batches_path, class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">請求件数</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= @billing_batch.invoice_count %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">得意先数</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= @billing_batch.customer_count %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">金額合計</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= money(@billing_batch.total_amount) %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">実行者</div>
      <div class="mt-2 text-lg font-semibold text-slate-900"><%= @billing_batch.executed_by&.name.presence || "システム" %></div>
      <div class="mt-1 text-xs text-slate-500"><%= @billing_batch.executed_at.present? ? @billing_batch.executed_at.strftime("%Y/%m/%d %H:%M") : "-" %></div>
    </div>
  </div>

  <div class="grid gap-4 xl:grid-cols-[0.95fr_1.05fr]">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-900">締め情報</h2>
      <dl class="mt-3 space-y-3 text-sm text-slate-800">
        <div>
          <dt class="text-xs text-slate-500">請求期間</dt>
          <dd><%= jp_date(@billing_batch.billing_period_from) %> 〜 <%= jp_date(@billing_batch.billing_period_to) %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">個別期日用デフォルト</dt>
          <dd><%= jp_date(@billing_batch.default_due_date) %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">メモ</dt>
          <dd><%= simple_format(@billing_batch.note.presence || "-") %></dd>
        </div>
        <% if @billing_batch.cancelled_at.present? %>
          <div>
            <dt class="text-xs text-slate-500">解除者</dt>
            <dd><%= @billing_batch.cancelled_by&.name.presence || "-" %></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">解除日時</dt>
            <dd><%= @billing_batch.cancelled_at.strftime("%Y/%m/%d %H:%M") %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-4 py-3">
        <h2 class="text-sm font-semibold text-slate-900">請求書一覧</h2>
      </div>
      <% if @invoices.any? %>
        <table class="min-w-full text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-4 py-2">請求番号</th>
              <th class="px-4 py-2">得意先</th>
              <th class="px-4 py-2">支払期日</th>
              <th class="px-4 py-2">金額</th>
              <th class="px-4 py-2">状態</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @invoices.each do |invoice| %>
              <tr>
                <td class="px-4 py-2 font-semibold text-slate-900"><%= link_to invoice.invoice_number, admin_invoice_path(invoice), class: "hover:underline" %></td>
                <td class="px-4 py-2 text-slate-700"><%= invoice.customer.name %></td>
                <td class="px-4 py-2 text-slate-700"><%= jp_date(invoice.due_date) %></td>
                <td class="px-4 py-2 text-slate-700"><%= money(invoice.total_amount) %></td>
                <td class="px-4 py-2"><%= invoice_status_badge(invoice) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="px-4 py-6 text-sm text-slate-500">この締めでは請求書は発行されていません。</div>
      <% end %>
    </div>
  </div>
</div>
