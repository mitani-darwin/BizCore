<% content_for :page_title, "在庫詳細" %>

<div class="space-y-4">
  <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-xl font-semibold text-slate-900"><%= @stock_item.product.name %></h1>
        <%= stock_alert_badge(@stock_item) %>
      </div>
      <p class="text-sm text-slate-600"><%= @stock_item.warehouse.name %> / <%= @stock_item.product.code %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if can?("admin.stock_movements.create") %>
        <%= link_to "入庫・調整を登録", new_admin_stock_movement_path(stock_item_id: @stock_item.id), class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
      <% end %>
      <% if can?("admin.stock_counts.create") %>
        <%= link_to "棚卸を登録", new_admin_stock_count_path(stock_item_id: @stock_item.id), class: "rounded border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
      <% end %>
      <% if can?("admin.stock_items.update") %>
        <%= link_to "安全在庫を編集", edit_admin_stock_item_path(@stock_item), class: "rounded bg-sky-600 px-3 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      <% end %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">現在庫</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= @stock_item.quantity_on_hand %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">引当済</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= @stock_item.quantity_reserved %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">利用可能</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= @stock_item.available_quantity %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">安全在庫</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= @stock_item.safety_stock %></div>
    </div>
  </div>

  <div class="grid gap-4 xl:grid-cols-[1fr_1fr]">
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3">
        <h2 class="text-sm font-semibold text-slate-900">最近の在庫移動</h2>
        <%= link_to "履歴一覧へ", admin_stock_movements_path, class: "text-xs font-semibold text-sky-700 hover:underline" %>
      </div>
      <% if @recent_movements.any? %>
        <div class="divide-y divide-slate-100">
          <% @recent_movements.each do |movement| %>
            <div class="flex items-center justify-between px-4 py-3 text-sm">
              <div>
                <div class="flex items-center gap-2">
                  <%= stock_movement_badge(movement) %>
                  <span class="font-semibold text-slate-900"><%= jp_date(movement.occurred_on) %></span>
                </div>
                <div class="mt-1 text-xs text-slate-500"><%= movement.note.presence || "-" %></div>
              </div>
              <div class="<%= movement.signed_quantity.negative? ? 'text-rose-700' : 'text-emerald-700' %> font-semibold">
                <%= signed_stock_quantity(movement.signed_quantity) %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="px-4 py-6 text-sm text-slate-500">まだ在庫移動はありません。</div>
      <% end %>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3">
        <h2 class="text-sm font-semibold text-slate-900">棚卸履歴</h2>
        <%= link_to "棚卸一覧へ", admin_stock_counts_path, class: "text-xs font-semibold text-sky-700 hover:underline" %>
      </div>
      <% if @recent_counts.any? %>
        <div class="divide-y divide-slate-100">
          <% @recent_counts.each do |stock_count| %>
            <div class="flex items-center justify-between px-4 py-3 text-sm">
              <div>
                <div class="font-semibold text-slate-900"><%= stock_count.counted_at.strftime("%Y/%m/%d %H:%M") %></div>
                <div class="mt-1 text-xs text-slate-500">帳簿 <%= stock_count.quantity_before %> / 実在庫 <%= stock_count.counted_quantity %></div>
              </div>
              <div><%= stock_count_adjustment_badge(stock_count) %></div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="px-4 py-6 text-sm text-slate-500">まだ棚卸履歴はありません。</div>
      <% end %>
    </div>
  </div>

  <div class="flex gap-2">
    <%= link_to "一覧へ戻る", admin_stock_items_path, class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
    <% if can?("admin.stock_items.update") %>
      <%= link_to "安全在庫を編集", edit_admin_stock_item_path(@stock_item), class: "rounded border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
    <% end %>
  </div>
</div>
