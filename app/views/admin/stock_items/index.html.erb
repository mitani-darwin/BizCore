<% content_for :page_title, "在庫一覧" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">在庫一覧</h1>
      <p class="text-sm text-slate-600">倉庫ごとの在庫、引当、安全在庫アラートを確認します。</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if can?("admin.stock_movements.create") %>
        <%= link_to "入庫・調整を登録", new_admin_stock_movement_path, class: "rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
      <% end %>
      <% if can?("admin.stock_counts.create") %>
        <%= link_to "棚卸を登録", new_admin_stock_count_path, class: "rounded-lg border border-sky-200 bg-sky-50 px-4 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
      <% end %>
      <% if can?("admin.stock_items.create") %>
        <%= link_to "在庫を追加", new_admin_stock_item_path, class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      <% end %>
    </div>
  </div>

  <%# KPI カード %>
  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-semibold text-slate-500">在庫品目数</p>
      <p class="mt-2 text-3xl font-bold text-slate-900"><%= @pagy.count %></p>
    </div>
    <div class="rounded-xl border border-<%= @low_stock_count > 0 ? "amber" : "slate" %>-200 bg-<%= @low_stock_count > 0 ? "amber" : "slate" %>-50 p-4 shadow-sm">
      <p class="text-xs font-semibold text-<%= @low_stock_count > 0 ? "amber" : "slate" %>-500">安全在庫割れ</p>
      <p class="mt-2 text-3xl font-bold text-<%= @low_stock_count > 0 ? "amber-600" : "slate-900" %>"><%= @low_stock_count %></p>
    </div>
    <div class="rounded-xl border border-<%= @out_of_stock_count > 0 ? "rose" : "slate" %>-200 bg-<%= @out_of_stock_count > 0 ? "rose" : "slate" %>-50 p-4 shadow-sm">
      <p class="text-xs font-semibold text-<%= @out_of_stock_count > 0 ? "rose" : "slate" %>-500">在庫切れ</p>
      <p class="mt-2 text-3xl font-bold text-<%= @out_of_stock_count > 0 ? "rose-600" : "slate-900" %>"><%= @out_of_stock_count %></p>
    </div>
  </div>

  <%# アラートフィルタータブ %>
  <div class="flex gap-1 rounded-lg border border-slate-200 bg-slate-50 p-1 w-fit">
    <%= link_to admin_stock_items_path,
          class: "rounded-md px-3 py-1.5 text-xs font-semibold #{@alert_filter.nil? ? "bg-white shadow text-slate-900" : "text-slate-500 hover:text-slate-700"}" do %>
      全件
    <% end %>
    <%= link_to admin_stock_items_path(alert: "low_stock"),
          class: "rounded-md px-3 py-1.5 text-xs font-semibold flex items-center gap-1 #{@alert_filter == "low_stock" ? "bg-white shadow text-amber-700" : "text-slate-500 hover:text-slate-700"}" do %>
      在庫不足
      <% if @low_stock_count > 0 %>
        <span class="rounded-full bg-amber-100 px-1.5 text-[10px] font-bold text-amber-700"><%= @low_stock_count %></span>
      <% end %>
    <% end %>
    <%= link_to admin_stock_items_path(alert: "out_of_stock"),
          class: "rounded-md px-3 py-1.5 text-xs font-semibold flex items-center gap-1 #{@alert_filter == "out_of_stock" ? "bg-white shadow text-rose-700" : "text-slate-500 hover:text-slate-700"}" do %>
      在庫切れ
      <% if @out_of_stock_count > 0 %>
        <span class="rounded-full bg-rose-100 px-1.5 text-[10px] font-bold text-rose-700"><%= @out_of_stock_count %></span>
      <% end %>
    <% end %>
  </div>

  <% if @stock_items.any? %>
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">倉庫</th>
            <th class="px-4 py-2">商品</th>
            <th class="px-4 py-2 text-right">実在庫</th>
            <th class="px-4 py-2 text-right">引当</th>
            <th class="px-4 py-2 text-right">利用可能</th>
            <th class="px-4 py-2 text-right">安全在庫</th>
            <th class="px-4 py-2">状態</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @stock_items.each do |stock_item| %>
            <% row_bg = stock_item.out_of_stock? ? "bg-rose-50" : stock_item.low_stock? ? "bg-amber-50" : "" %>
            <tr class="hover:bg-slate-50 <%= row_bg %>">
              <td class="px-4 py-2 text-slate-700"><%= stock_item.warehouse.name %></td>
              <td class="px-4 py-2">
                <div class="font-semibold text-slate-900"><%= stock_item.product.name %></div>
                <div class="text-xs text-slate-500 font-mono"><%= stock_item.product.code %></div>
              </td>
              <td class="px-4 py-2 text-right text-slate-700"><%= stock_item.quantity_on_hand %></td>
              <td class="px-4 py-2 text-right text-slate-500"><%= stock_item.quantity_reserved %></td>
              <td class="px-4 py-2 text-right font-semibold <%= stock_item.out_of_stock? ? "text-rose-600" : stock_item.low_stock? ? "text-amber-600" : "text-slate-900" %>">
                <%= stock_item.available_quantity %>
              </td>
              <td class="px-4 py-2 text-right text-slate-500"><%= stock_item.safety_stock %></td>
              <td class="px-4 py-2">
                <% if stock_item.out_of_stock? %>
                  <span class="inline-flex rounded-full bg-rose-100 px-2 py-0.5 text-[11px] font-semibold text-rose-700">在庫切れ</span>
                <% elsif stock_item.low_stock? %>
                  <span class="inline-flex rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-700">在庫不足</span>
                <% else %>
                  <span class="inline-flex rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-semibold text-emerald-700">正常</span>
                <% end %>
              </td>
              <td class="px-4 py-2 text-right">
                <div class="inline-flex gap-2">
                  <%= link_to "詳細", admin_stock_item_path(stock_item), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
                  <% if can?("admin.stock_items.update") %>
                    <%= link_to "編集", edit_admin_stock_item_path(stock_item), class: "rounded border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "shared/pagy", pagy: @pagy %>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <% if @alert_filter.present? %>
        <p>アラート対象の在庫はありません。</p>
      <% else %>
        <p>在庫がまだ登録されていません。</p>
      <% end %>
    </div>
  <% end %>
</div>
