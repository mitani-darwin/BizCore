<% content_for :page_title, "仕入締め一覧" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">仕入締め一覧</h1>
      <p class="text-sm text-slate-600">月次仕入請求の締め実行履歴です。</p>
    </div>
    <%= link_to "仕入請求一覧へ", admin_purchase_bills_path, class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
  </div>

  <% if @purchase_bill_batches.any? %>
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">締め番号</th>
            <th class="px-4 py-2">締日</th>
            <th class="px-4 py-2">請求期間</th>
            <th class="px-4 py-2">請求日</th>
            <th class="px-4 py-2">請求件数</th>
            <th class="px-4 py-2">金額</th>
            <th class="px-4 py-2">状態</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @purchase_bill_batches.each do |purchase_bill_batch| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2 font-semibold text-slate-900"><%= purchase_bill_batch.batch_number %></td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(purchase_bill_batch.closing_date) %></td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(purchase_bill_batch.billing_period_from) %> 〜 <%= jp_date(purchase_bill_batch.billing_period_to) %></td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(purchase_bill_batch.bill_date) %></td>
              <td class="px-4 py-2 text-slate-700"><%= purchase_bill_batch.bill_count %></td>
              <td class="px-4 py-2 text-slate-700"><%= money(purchase_bill_batch.total_amount) %></td>
              <td class="px-4 py-2"><%= purchase_bill_batch_status_badge(purchase_bill_batch) %></td>
              <td class="px-4 py-2 text-right">
                <%= link_to "詳細", admin_purchase_bill_batch_path(purchase_bill_batch), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "shared/pagy", pagy: @pagy %>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <p>仕入締めはまだ実行されていません。</p>
    </div>
  <% end %>
</div>
