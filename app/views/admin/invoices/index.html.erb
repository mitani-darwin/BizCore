<% content_for :page_title, "請求一覧" %>

<div class="space-y-4">
  <div class="grid gap-4 xl:grid-cols-[0.9fr_1.1fr]">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h1 class="text-xl font-semibold text-slate-900">請求一覧</h1>
      <p class="mt-1 text-sm text-slate-600">請求締めを実行し、発行済の請求書と締め履歴を確認します。</p>
      <% if can?("admin.billing_batches.read") %>
        <div class="mt-4">
          <%= link_to "請求締め履歴へ", admin_billing_batches_path, class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
        </div>
      <% end %>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-sm font-semibold text-slate-900">4. 月次請求を締める</h2>
          <p class="text-xs text-slate-500">期間を締め、対象顧客ごとに請求書を作成します。締め済み期間は再実行できません。</p>
        </div>
      </div>

      <% if can?("admin.invoices.create") %>
        <%= form_with url: issue_monthly_admin_invoices_path, method: :post, local: true, class: "mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-5" do %>
          <div>
            <label class="block text-xs font-semibold text-slate-700">請求期間開始</label>
            <%= date_field_tag :billing_period_from, @billing_defaults[:billing_period_from], class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700">請求期間終了</label>
            <%= date_field_tag :billing_period_to, @billing_defaults[:billing_period_to], class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700">締日</label>
            <%= date_field_tag :closing_date, @billing_defaults[:closing_date], class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700">請求日</label>
            <%= date_field_tag :invoice_date, @billing_defaults[:invoice_date], class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700">個別期日用デフォルト</label>
            <%= date_field_tag :default_due_date, @billing_defaults[:default_due_date], class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
          </div>
          <div class="sm:col-span-2 xl:col-span-5">
            <label class="block text-xs font-semibold text-slate-700">締めメモ</label>
            <%= text_area_tag :note, @billing_defaults[:note], rows: 2, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm", placeholder: "今回の締めに残すメモ" %>
          </div>
          <div class="sm:col-span-2 xl:col-span-5">
            <%= submit_tag "請求締めを実行", class: "rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-700" %>
          </div>
        <% end %>
      <% else %>
        <p class="mt-4 text-sm text-slate-500">請求書を発行する権限がありません。</p>
      <% end %>
    </div>
  </div>

  <% if @recent_billing_batches.any? %>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-slate-900">最近の請求締め</h2>
        <% if can?("admin.billing_batches.read") %>
          <%= link_to "すべて見る", admin_billing_batches_path, class: "text-xs font-semibold text-sky-700 hover:underline" %>
        <% end %>
      </div>
      <div class="mt-3 space-y-2">
        <% @recent_billing_batches.each do |billing_batch| %>
          <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3 text-sm">
            <div class="flex items-center justify-between gap-3">
              <div>
                <div class="flex items-center gap-2">
                  <%= billing_batch_status_badge(billing_batch) %>
                  <%= link_to billing_batch.batch_number, admin_billing_batch_path(billing_batch), class: "font-semibold text-slate-900 hover:underline" %>
                </div>
                <div class="mt-1 text-xs text-slate-500"><%= jp_date(billing_batch.billing_period_from) %> 〜 <%= jp_date(billing_batch.billing_period_to) %> / 請求 <%= billing_batch.invoice_count %>件</div>
              </div>
              <div class="text-right">
                <div class="font-semibold text-slate-900"><%= money(billing_batch.total_amount) %></div>
                <div class="text-xs text-slate-500"><%= billing_batch.executed_by&.name.presence || "システム" %></div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @invoices.any? %>
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">請求番号</th>
            <th class="px-4 py-2">締め番号</th>
            <th class="px-4 py-2">得意先</th>
            <th class="px-4 py-2">請求日</th>
            <th class="px-4 py-2">支払期日</th>
            <th class="px-4 py-2">請求額</th>
            <th class="px-4 py-2">残高</th>
            <th class="px-4 py-2">状態</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @invoices.each do |invoice| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2 font-semibold text-slate-900"><%= invoice.invoice_number %></td>
              <td class="px-4 py-2 text-slate-700">
                <% if invoice.billing_batch.present? %>
                  <%= link_to invoice.billing_batch.batch_number, admin_billing_batch_path(invoice.billing_batch), class: "hover:underline" %>
                <% else %>
                  -
                <% end %>
              </td>
              <td class="px-4 py-2 text-slate-700"><%= invoice.customer.name %></td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(invoice.invoice_date) %></td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(invoice.due_date) %></td>
              <td class="px-4 py-2 text-slate-700"><%= money(invoice.total_amount) %></td>
              <td class="px-4 py-2 text-slate-700"><%= money(invoice.balance_amount) %></td>
              <td class="px-4 py-2"><%= invoice_status_badge(invoice) %></td>
              <td class="px-4 py-2 text-right">
                <%= link_to "詳細", admin_invoice_path(invoice), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <p>請求書はまだ発行されていません。</p>
    </div>
  <% end %>
</div>
