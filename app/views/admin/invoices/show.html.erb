<% content_for :page_title, "請求詳細" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-xl font-semibold text-slate-900"><%= @invoice.invoice_number %></h1>
        <%= invoice_status_badge(@invoice) %>
      </div>
      <p class="text-sm text-slate-600"><%= @invoice.customer.name %> / 請求日 <%= jp_date(@invoice.invoice_date) %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Excel出力", download_excel_admin_invoice_path(@invoice), class: "rounded border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-100" %>
      <%= link_to "PDF出力", download_pdf_admin_invoice_path(@invoice), class: "rounded border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-100" %>
      <% if can?("admin.payments.create") && @invoice.balance_amount.to_d.positive? && !@invoice.cancelled? %>
        <%= link_to "この請求の入金を登録", new_admin_payment_path(source_invoice_id: @invoice.id), class: "rounded border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-100" %>
      <% end %>
      <% if can?("admin.invoices.update") && @invoice.cancellable? %>
        <%= button_to "請求を取消", cancel_admin_invoice_path(@invoice), method: :patch, class: "rounded border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-100" %>
      <% end %>
      <% if can?("admin.invoices.create") && @invoice.reissuable? %>
        <%= button_to "請求を再発行", reissue_admin_invoice_path(@invoice), method: :post, params: { invoice_date: Date.current, default_due_date: @invoice.due_date }, class: "rounded border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
      <% end %>
      <%= link_to "一覧へ", admin_invoices_path, class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
    </div>
  </div>

  <div class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-2 text-xs text-slate-600 flex items-center justify-between">
    <span>⚖️ 電子帳簿保存法に基づき電子データとして保存されています</span>
    <span class="font-semibold">保存期限: <%= @invoice.retention_deadline.strftime("%Y/%m/%d") %> まで</span>
  </div>

  <% if current_tenant.qualified_invoice_issuer? %>
    <div class="rounded-lg border border-sky-200 bg-sky-50 px-4 py-2 text-sm text-sky-800">
      適格請求書発行事業者　登録番号: <span class="font-mono font-semibold"><%= current_tenant.invoice_registration_number %></span>
    </div>
  <% end %>

  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">請求額</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= money(@invoice.total_amount) %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">入金額</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= money(@invoice.paid_amount) %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">残高</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= money(@invoice.balance_amount) %></div>
    </div>
  </div>

  <div class="grid gap-4 xl:grid-cols-[1.1fr_0.9fr]">
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-4 py-3">
        <h2 class="text-sm font-semibold text-slate-900">請求明細</h2>
      </div>
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">内容</th>
            <th class="px-4 py-2">数量</th>
            <th class="px-4 py-2">単価</th>
            <th class="px-4 py-2">税区分</th>
            <th class="px-4 py-2">金額</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @invoice.invoice_items.each do |item| %>
            <tr>
              <td class="px-4 py-2 text-slate-700"><%= item.description %></td>
              <td class="px-4 py-2 text-slate-700"><%= item.quantity %></td>
              <td class="px-4 py-2 text-slate-700"><%= money(item.unit_price) %></td>
              <td class="px-4 py-2 text-slate-700"><%= tax_category_label(item.tax_category) %></td>
              <td class="px-4 py-2 text-slate-700"><%= money(item.amount) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="space-y-4">
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold text-slate-900">請求情報</h2>
        <dl class="mt-3 space-y-3 text-sm text-slate-800">
          <div>
            <dt class="text-xs text-slate-500">請求締め</dt>
            <dd>
              <% if @invoice.billing_batch.present? %>
                <%= link_to @invoice.billing_batch.batch_number, admin_billing_batch_path(@invoice.billing_batch), class: "text-sky-700 hover:underline" %>
              <% else %>
                -
              <% end %>
            </dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">請求期間</dt>
            <dd><%= jp_date(@invoice.billing_period_from) %> 〜 <%= jp_date(@invoice.billing_period_to) %></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">締日</dt>
            <dd><%= jp_date(@invoice.closing_date) %> (<%= @invoice.closing_day_snapshot.presence || "-" %>日締め)</dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">支払期日</dt>
            <dd><%= jp_date(@invoice.due_date) %></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">請求送付方法</dt>
            <dd><%= invoice_delivery_method_label(@invoice.invoice_delivery_method_snapshot) %></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">支払条件</dt>
            <dd><%= payment_due_rule_label(@invoice.payment_due_rule_snapshot) %></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">再発行元</dt>
            <dd>
              <% if @invoice.reissued_from.present? %>
                <%= link_to @invoice.reissued_from.invoice_number, admin_invoice_path(@invoice.reissued_from), class: "text-sky-700 hover:underline" %>
              <% else %>
                -
              <% end %>
            </dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">金額内訳</dt>
            <dd class="mt-1 space-y-1 rounded-lg bg-slate-50 p-3 text-sm">
              <div class="flex justify-between">
                <span>小計</span>
                <span><%= money(@invoice.subtotal_amount) %></span>
              </div>
              <% @invoice.tax_breakdown.each do |category, amounts| %>
                <div class="flex justify-between text-slate-500 text-xs">
                  <span><%= tax_category_label(category) %>対象 小計</span>
                  <span><%= money(amounts[:subtotal]) %></span>
                </div>
                <div class="flex justify-between text-slate-500 text-xs">
                  <span>うち消費税（<%= tax_category_label(category) %>）</span>
                  <span><%= money(amounts[:tax]) %></span>
                </div>
              <% end %>
              <div class="flex justify-between border-t border-slate-200 pt-1 font-semibold">
                <span>合計（税込）</span>
                <span><%= money(@invoice.total_amount) %></span>
              </div>
            </dd>
          </div>

          <div>
            <dt class="text-xs text-slate-500">備考</dt>
            <dd><%= simple_format(@invoice.remarks.presence || "-") %></dd>
          </div>
          <% if @invoice.cancelled_at.present? %>
            <div>
              <dt class="text-xs text-slate-500">取消日時</dt>
              <dd><%= @invoice.cancelled_at.strftime("%Y/%m/%d %H:%M") %></dd>
            </div>
          <% end %>
        </dl>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold text-slate-900">入金履歴</h2>
        <% if @invoice.payment_allocations.any? %>
          <div class="mt-3 space-y-2">
            <% @invoice.payment_allocations.each do |allocation| %>
              <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3 text-sm text-slate-700">
                <div class="flex items-center justify-between">
                  <div>
                    <div class="font-semibold text-slate-900">
                      <%= link_to allocation.payment.payment_number, admin_payment_path(allocation.payment), class: "hover:underline" %>
                    </div>
                    <div class="text-xs text-slate-500"><%= allocation.allocated_at.strftime("%Y/%m/%d %H:%M") %></div>
                  </div>
                  <div class="font-semibold text-slate-900"><%= money(allocation.allocated_amount) %></div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="mt-3 text-sm text-slate-500">まだ入金は消し込まれていません。</p>
        <% end %>
      </div>

      <% if @invoice.reissues.any? %>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-semibold text-slate-900">再発行履歴</h2>
          <div class="mt-3 space-y-2">
            <% @invoice.reissues.order(:created_at).each do |reissue| %>
              <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3 text-sm">
                <div class="flex items-center justify-between">
                  <div>
                    <div class="font-semibold text-slate-900"><%= link_to reissue.invoice_number, admin_invoice_path(reissue), class: "hover:underline" %></div>
                    <div class="text-xs text-slate-500">請求日 <%= jp_date(reissue.invoice_date) %></div>
                  </div>
                  <%= invoice_status_badge(reissue) %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
