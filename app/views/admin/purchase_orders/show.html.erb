<% content_for :page_title, "発注詳細" %>

<div class="space-y-4">
  <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-xl font-semibold text-slate-900"><%= @purchase_order.purchase_order_number %></h1>
        <%= purchase_order_status_badge(@purchase_order) %>
      </div>
      <p class="text-sm text-slate-600"><%= @purchase_order.supplier.name %> / 発注日 <%= jp_date(@purchase_order.order_date) %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if can?("admin.purchase_orders.update") && @purchase_order.draft? %>
        <%= link_to "編集", edit_admin_purchase_order_path(@purchase_order), class: "rounded border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
        <%= button_to "発注書を送信", send_purchase_order_admin_purchase_order_path(@purchase_order), method: :patch, class: "rounded bg-sky-600 px-3 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      <% end %>
    </div>
  </div>

  <div class="grid gap-4 xl:grid-cols-[1.2fr_0.8fr]">
    <div class="space-y-4">
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold text-slate-900">発注情報</h2>
        <dl class="mt-3 grid gap-4 sm:grid-cols-2 text-sm text-slate-800">
          <div>
            <dt class="text-xs text-slate-500">入荷倉庫</dt>
            <dd><%= @purchase_order.warehouse.name %></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">希望納期</dt>
            <dd><%= jp_date(@purchase_order.requested_delivery_date) %></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">仕入先担当者</dt>
            <dd><%= @purchase_order.supplier.primary_contact.presence || "-" %></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">発注担当者</dt>
            <dd><%= @purchase_order.ordered_by_name.presence || "-" %></dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="text-xs text-slate-500">備考</dt>
            <dd><%= @purchase_order.remarks.presence || "-" %></dd>
          </div>
        </dl>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-4 py-3">
          <h2 class="text-sm font-semibold text-slate-900">発注明細</h2>
        </div>
        <table class="min-w-full text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-4 py-2">商品</th>
              <th class="px-4 py-2">発注数量</th>
              <th class="px-4 py-2">入荷済</th>
              <th class="px-4 py-2">残数量</th>
              <th class="px-4 py-2">単価</th>
              <th class="px-4 py-2">金額</th>
              <th class="px-4 py-2">状態</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @purchase_order.purchase_order_items.each do |item| %>
              <tr>
                <td class="px-4 py-2 text-slate-700">
                  <div class="font-semibold text-slate-900"><%= item.product_name_snapshot %></div>
                  <div class="text-xs text-slate-500"><%= item.product_code_snapshot %></div>
                </td>
                <td class="px-4 py-2 text-slate-700"><%= item.quantity %> <%= item.unit_name_snapshot %></td>
                <td class="px-4 py-2 text-slate-700"><%= item.received_quantity %></td>
                <td class="px-4 py-2 text-slate-700"><%= item.remaining_quantity %></td>
                <td class="px-4 py-2 text-slate-700"><%= money(item.unit_cost) %></td>
                <td class="px-4 py-2 text-slate-700"><%= money(item.amount) %></td>
                <td class="px-4 py-2 text-slate-700"><%= purchase_order_item_status_label(item.status) %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="bg-slate-50">
            <tr>
              <td colspan="5" class="px-4 py-3 text-right text-sm font-semibold text-slate-700">合計</td>
              <td class="px-4 py-3 text-sm font-semibold text-slate-900"><%= money(@purchase_order.total_amount) %></td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold text-slate-900">入荷履歴</h2>
          <% if @purchase_receipts.any? %>
            <%= link_to "入荷一覧へ", admin_purchase_receipts_path, class: "text-xs font-semibold text-sky-700 hover:underline" %>
          <% end %>
        </div>
        <% if @purchase_receipts.any? %>
          <div class="mt-3 space-y-2">
            <% @purchase_receipts.each do |receipt| %>
              <div class="flex items-center justify-between rounded-lg border border-slate-100 px-4 py-3 text-sm">
                <div>
                  <div class="font-semibold text-slate-900"><%= link_to receipt.purchase_receipt_number, admin_purchase_receipt_path(receipt), class: "hover:underline" %></div>
                  <div class="text-xs text-slate-500">入荷日 <%= jp_date(receipt.received_on) %></div>
                </div>
                <%= purchase_receipt_status_badge(receipt) %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="mt-3 text-sm text-slate-500">まだ入荷は登録されていません。</p>
        <% end %>
      </div>
    </div>

    <div class="space-y-4">
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold text-slate-900">進行アクション</h2>
        <div class="mt-3 space-y-3">
          <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
            <div class="text-xs font-semibold text-slate-500">1. 発注書を送る</div>
            <% if can?("admin.purchase_orders.update") && @purchase_order.draft? %>
              <div class="mt-2">
                <%= button_to "発注書を送信", send_purchase_order_admin_purchase_order_path(@purchase_order), method: :patch, class: "rounded bg-sky-600 px-3 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
              </div>
            <% else %>
              <div class="mt-2 text-sm text-slate-600">現在の状態: <%= purchase_order_status_label(@purchase_order.status) %></div>
            <% end %>
          </div>

          <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
            <div class="text-xs font-semibold text-slate-500">2. 入荷を登録</div>
            <% if can?("admin.purchase_orders.update") && @purchase_order.receivable? && @purchase_order.purchase_order_items.any? { |item| item.remaining_quantity.positive? } %>
              <%= form_with url: receive_items_admin_purchase_order_path(@purchase_order), method: :patch, local: true, class: "mt-3 space-y-3" do %>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                  <div>
                    <label class="block text-xs font-semibold text-slate-700">入荷日</label>
                    <%= date_field_tag :received_on, Date.current, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-slate-700">入荷担当者</label>
                    <%= text_field_tag :received_by_name, nil, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-700">入荷メモ</label>
                  <%= text_area_tag :remarks, nil, rows: 2, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
                </div>
                <% @purchase_order.purchase_order_items.select { |item| item.remaining_quantity.positive? }.each do |item| %>
                  <div class="rounded-lg border border-slate-100 bg-white px-4 py-3">
                    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                      <div>
                        <div class="font-semibold text-slate-900"><%= item.product_name_snapshot %></div>
                        <div class="text-xs text-slate-500">残数量 <%= item.remaining_quantity %> <%= item.unit_name_snapshot %></div>
                      </div>
                      <div class="sm:w-40">
                        <label class="block text-xs font-semibold text-slate-700">今回入荷数量</label>
                        <%= number_field_tag "received_quantities[#{item.id}]", nil, min: 0, max: item.remaining_quantity, step: 1, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
                      </div>
                    </div>
                  </div>
                <% end %>
                <%= submit_tag "入荷を登録", class: "rounded bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-700" %>
              <% end %>
            <% elsif @purchase_order.received? %>
              <div class="mt-2 text-sm text-slate-600">すべての明細が入荷済です。</div>
            <% else %>
              <div class="mt-2 text-sm text-slate-600">発注書送信後に入荷登録できます。</div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold text-slate-900">進捗サマリ</h2>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
            <div class="text-xs text-slate-500">入荷済数量</div>
            <div class="mt-1 text-xl font-semibold text-slate-900"><%= @purchase_order.total_received_quantity %></div>
          </div>
          <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
            <div class="text-xs text-slate-500">残数量</div>
            <div class="mt-1 text-xl font-semibold text-slate-900"><%= @purchase_order.total_remaining_quantity %></div>
          </div>
          <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
            <div class="text-xs text-slate-500">返品金額</div>
            <div class="mt-1 text-xl font-semibold text-rose-700"><%= @purchase_order.total_return_amount.positive? ? "-#{money(@purchase_order.total_return_amount)}" : money(0) %></div>
          </div>
          <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
            <div class="text-xs text-slate-500">値引金額</div>
            <div class="mt-1 text-xl font-semibold text-amber-700"><%= @purchase_order.total_discount_amount.positive? ? "-#{money(@purchase_order.total_discount_amount)}" : money(0) %></div>
          </div>
        </div>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold text-slate-900">最近の返品/値引き</h2>
          <% if @purchase_adjustments.any? %>
            <%= link_to "一覧へ", admin_purchase_adjustments_path, class: "text-xs font-semibold text-sky-700 hover:underline" %>
          <% end %>
        </div>
        <% if @purchase_adjustments.any? %>
          <div class="mt-3 space-y-2">
            <% @purchase_adjustments.each do |adjustment| %>
              <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3 text-sm">
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <div class="flex items-center gap-2">
                      <%= purchase_adjustment_status_badge(adjustment) %>
                      <%= link_to adjustment.adjustment_number, admin_purchase_adjustment_path(adjustment), class: "font-semibold text-slate-900 hover:underline" %>
                    </div>
                    <div class="mt-1 text-xs text-slate-500"><%= jp_date(adjustment.adjustment_date) %> / <%= adjustment.product_name_snapshot.presence || "入荷全体値引き" %></div>
                  </div>
                  <div class="font-semibold <%= adjustment.purchase_return? ? 'text-rose-700' : 'text-amber-700' %>"><%= purchase_adjustment_signed_amount(adjustment) %></div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="mt-3 text-sm text-slate-500">返品/値引きはまだ登録されていません。</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="flex gap-2">
    <%= link_to "一覧へ戻る", admin_purchase_orders_path, class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
    <% if can?("admin.purchase_orders.update") && @purchase_order.draft? %>
      <%= link_to "編集", edit_admin_purchase_order_path(@purchase_order), class: "rounded border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
    <% end %>
  </div>
</div>
