<%= form_with model: [:admin, leave_request], local: true, class: "space-y-6",
      data: { controller: "leave-request" } do |f| %>
  <% if leave_request.errors.any? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
      <p class="font-semibold">入力内容にエラーがあります。</p>
      <ul class="list-disc pl-5">
        <% leave_request.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :employee_id, "従業員", class: "block text-sm font-medium text-slate-800" %>
      <%= f.collection_select :employee_id, @employee_options, :id, :title, { include_blank: "選択してください" }, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :leave_type, "休暇区分", class: "block text-sm font-medium text-slate-800" %>
      <%= f.select :leave_type, options_for_select(leave_type_options, leave_request.leave_type), {}, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
    </div>
    <div class="sm:col-span-2">
      <%= f.label :half_day_type, "取得区分", class: "block text-sm font-medium text-slate-800" %>
      <div class="mt-2 flex flex-wrap gap-3">
        <% [["全休", "none"], ["午前半休", "morning"], ["午後半休", "afternoon"]].each do |label, value| %>
          <label class="flex cursor-pointer items-center gap-2 rounded-lg border px-4 py-2 text-sm font-medium transition
            has-[:checked]:border-sky-500 has-[:checked]:bg-sky-50 has-[:checked]:text-sky-700
            border-slate-200 text-slate-700 hover:bg-slate-50">
            <%= f.radio_button :half_day_type, value,
                class: "accent-sky-600",
                data: { leave_request_target: "halfDayType", action: "change->leave-request#syncHalfDay" } %>
            <%= label %>
          </label>
        <% end %>
      </div>
    </div>
    <div>
      <%= f.label :start_date, "開始日", class: "block text-sm font-medium text-slate-800" %>
      <%= f.date_field :start_date, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm",
          data: { leave_request_target: "startDate", action: "change->leave-request#onStartDateChange" } %>
    </div>
    <div data-leave-request-target="endDateRow">
      <%= f.label :end_date, "終了日", class: "block text-sm font-medium text-slate-800" %>
      <%= f.date_field :end_date, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm",
          data: { leave_request_target: "endDate", action: "change->leave-request#calculate" } %>
    </div>
    <div>
      <%= f.label :days_count, "反映日数", class: "block text-sm font-medium text-slate-800" %>
      <%= f.number_field :days_count, min: 0.5, step: 0.5, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm",
          data: { leave_request_target: "daysCount" } %>
      <p class="mt-1 text-xs text-slate-500">開始日・終了日から自動入力。半休は 0.5 に変更してください。</p>
    </div>
  </div>

  <div>
    <%= f.label :reason, "理由", class: "block text-sm font-medium text-slate-800" %>
    <%= f.text_area :reason, rows: 3, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
  </div>

  <div>
    <%= f.label :note, "備考", class: "block text-sm font-medium text-slate-800" %>
    <%= f.text_area :note, rows: 3, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit "保存する", class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
    <%= link_to "キャンセル", leave_request.persisted? ? admin_leave_request_path(leave_request) : admin_leave_requests_path, class: "text-sm text-slate-600 hover:text-slate-800" %>
  </div>
<% end %>
