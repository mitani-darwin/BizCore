<% content_for :page_title, "入金詳細" %>

<div class="space-y-4">
  <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-xl font-semibold text-slate-900"><%= @payment.payment_number %></h1>
        <%= payment_status_badge(@payment) %>
      </div>
      <p class="text-sm text-slate-600"><%= @payment.customer.name %> / 入金日 <%= jp_date(@payment.payment_date) %></p>
    </div>
    <div class="flex gap-2">
      <% if can?("admin.payments.update") %>
        <%= link_to "編集", edit_admin_payment_path(@payment), class: "rounded border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
      <% end %>
      <%= link_to "一覧へ戻る", admin_payments_path, class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">入金額</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= money(@payment.amount) %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">消込済額</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= money(@payment.allocated_amount) %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">未消込額</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= money(@payment.unapplied_amount) %></div>
    </div>
  </div>

  <div class="grid gap-4 xl:grid-cols-[1fr_1fr]">
    <div class="space-y-4">
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold text-slate-900">入金情報</h2>
        <dl class="mt-3 space-y-3 text-sm text-slate-800">
          <div>
            <dt class="text-xs text-slate-500">入金方法</dt>
            <dd><%= payment_method_label(@payment.payment_method) %></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">銀行名</dt>
            <dd><%= @payment.bank_name.presence || "-" %></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">口座名義</dt>
            <dd><%= @payment.account_name.presence || "-" %></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">参照メモ</dt>
            <dd><%= @payment.reference_note.presence || "-" %></dd>
          </div>
        </dl>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold text-slate-900">消込履歴</h2>
        <% if @payment_allocations.any? %>
          <div class="mt-3 space-y-2">
            <% @payment_allocations.each do |allocation| %>
              <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3 text-sm text-slate-700">
                <div class="flex items-center justify-between">
                  <div>
                    <div class="font-semibold text-slate-900">
                      <%= link_to allocation.invoice.invoice_number, admin_invoice_path(allocation.invoice), class: "hover:underline" %>
                    </div>
                    <div class="text-xs text-slate-500">消込日時 <%= allocation.allocated_at.strftime("%Y/%m/%d %H:%M") %></div>
                  </div>
                  <div class="font-semibold text-slate-900"><%= money(allocation.allocated_amount) %></div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="mt-3 text-sm text-slate-500">まだ消し込みはありません。</p>
        <% end %>
      </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-900">5. 支払い確認（消し込み）</h2>
      <% if @payment.unapplied_amount <= 0 %>
        <p class="mt-3 text-sm text-slate-500">未消込額はありません。</p>
      <% elsif @reconcilable_invoices.empty? %>
        <p class="mt-3 text-sm text-slate-500">この得意先に消込対象の請求はありません。</p>
      <% elsif can?("admin.payments.update") %>
        <%= form_with url: reconcile_admin_payment_path(@payment), method: :patch, local: true, class: "mt-4 space-y-3" do %>
          <% @reconcilable_invoices.each do |invoice| %>
            <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <div class="font-semibold text-slate-900"><%= link_to invoice.invoice_number, admin_invoice_path(invoice), class: "hover:underline" %></div>
                  <div class="text-xs text-slate-500">支払期日 <%= jp_date(invoice.due_date) %> / 残高 <%= money(invoice.outstanding_amount) %></div>
                </div>
                <div class="sm:w-40">
                  <label class="block text-xs font-semibold text-slate-700">消込金額</label>
                  <%= number_field_tag "allocations[#{invoice.id}]", nil, min: 0, step: 1, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
                </div>
              </div>
            </div>
          <% end %>

          <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3 text-sm text-slate-700">
            未消込額: <span class="font-semibold text-slate-900"><%= money(@payment.unapplied_amount) %></span>
          </div>

          <%= submit_tag "消し込みを実行", class: "rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700" %>
        <% end %>
      <% else %>
        <p class="mt-3 text-sm text-slate-500">消し込み権限がありません。</p>
      <% end %>
    </div>
  </div>
</div>
