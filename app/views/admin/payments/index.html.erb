<% content_for :page_title, "入金一覧" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">入金一覧</h1>
      <p class="text-sm text-slate-600">入金登録と請求書への消し込み状況を管理します。</p>
    </div>
    <% if can?("admin.payments.create") %>
      <%= link_to "入金を登録", new_admin_payment_path, class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
    <% end %>
  </div>

  <% if @payments.any? %>
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">入金番号</th>
            <th class="px-4 py-2">得意先</th>
            <th class="px-4 py-2">入金日</th>
            <th class="px-4 py-2">入金額</th>
            <th class="px-4 py-2">未消込額</th>
            <th class="px-4 py-2">状態</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @payments.each do |payment| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2 font-semibold text-slate-900"><%= payment.payment_number %></td>
              <td class="px-4 py-2 text-slate-700"><%= payment.customer.name %></td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(payment.payment_date) %></td>
              <td class="px-4 py-2 text-slate-700"><%= money(payment.amount) %></td>
              <td class="px-4 py-2 text-slate-700"><%= money(payment.unapplied_amount) %></td>
              <td class="px-4 py-2"><%= payment_status_badge(payment) %></td>
              <td class="px-4 py-2 text-right">
                <div class="inline-flex gap-2">
                  <%= link_to "詳細", admin_payment_path(payment), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
                  <% if can?("admin.payments.update") %>
                    <%= link_to "編集", edit_admin_payment_path(payment), class: "rounded border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <p>入金はまだ登録されていません。</p>
    </div>
  <% end %>
</div>
