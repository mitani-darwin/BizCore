<% content_for :page_title, "契約一覧" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">契約一覧</h1>
      <p class="text-sm text-slate-600">得意先・仕入先との契約を管理します。</p>
    </div>
    <div class="flex gap-2">
      <% if can?("admin.contracts.read") %>
        <%= button_to "期限チェック実行", expire_alert_admin_contracts_path,
              method: :post,
              class: "rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50",
              data: { confirm: "契約期限チェックをキューに追加します。よろしいですか？" } %>
      <% end %>
      <% if can?("admin.contracts.create") %>
        <%= link_to "新規契約", new_admin_contract_path, class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: admin_contracts_path, method: :get, local: true,
        class: "grid gap-3 md:grid-cols-[minmax(0,1fr)_160px_160px_auto_auto]" do |f| %>
      <div>
        <%= f.label :q, "キーワード", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.text_field :q, value: @filters[:q], placeholder: "契約番号・件名",
            class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :status, "状態", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.select :status, options_for_select([["すべて", ""]] + contract_status_options, @filters[:status]), {},
            class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :counterparty_type, "区分", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.select :counterparty_type, options_for_select([["すべて", ""]] + contract_counterparty_type_options, @filters[:counterparty_type]), {},
            class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      </div>
      <div class="flex items-end">
        <%= f.submit "表示", class: "w-full rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      </div>
      <div class="flex items-end">
        <%= link_to "クリア", admin_contracts_path, class: "w-full rounded-lg border border-slate-200 bg-white px-4 py-2 text-center text-sm text-slate-700 hover:bg-slate-50" %>
      </div>
    <% end %>

    <div class="mt-4 grid gap-3 sm:grid-cols-4">
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">件数</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @summary[:count] %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">有効件数</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @summary[:active_count] %></div>
      </div>
      <div class="rounded-lg border border-amber-100 bg-amber-50 px-4 py-3">
        <div class="text-xs text-amber-700"><%= Contract::ALERT_THRESHOLDS.max %>日以内に期限切れ</div>
        <div class="mt-1 text-xl font-semibold text-amber-700"><%= @summary[:expiring_soon] %></div>
      </div>
      <div class="rounded-lg border border-<%= @summary[:already_expired] > 0 ? "rose-200 bg-rose-50" : "slate-100 bg-slate-50" %> px-4 py-3">
        <div class="text-xs text-<%= @summary[:already_expired] > 0 ? "rose-700" : "slate-500" %>">期限切れ未処理</div>
        <div class="mt-1 text-xl font-semibold text-<%= @summary[:already_expired] > 0 ? "rose-700" : "slate-900" %>"><%= @summary[:already_expired] %></div>
      </div>
    </div>

    <%# アラートフィルタータブ %>
    <div class="mt-3 flex gap-1 rounded-lg border border-slate-200 bg-slate-50 p-1 w-fit">
      <%= link_to admin_contracts_path(q: @filters[:q], status: @filters[:status], counterparty_type: @filters[:counterparty_type]),
            class: "rounded-md px-3 py-1.5 text-xs font-semibold #{@alert_filter.nil? ? "bg-white shadow text-slate-900" : "text-slate-500 hover:text-slate-700"}" do %>
        全件
      <% end %>
      <%= link_to admin_contracts_path(alert: "expiring_soon"),
            class: "rounded-md px-3 py-1.5 text-xs font-semibold flex items-center gap-1 #{@alert_filter == "expiring_soon" ? "bg-white shadow text-amber-700" : "text-slate-500 hover:text-slate-700"}" do %>
        期限間近
        <% if @summary[:expiring_soon] > 0 %>
          <span class="rounded-full bg-amber-100 px-1.5 text-[10px] font-bold text-amber-700"><%= @summary[:expiring_soon] %></span>
        <% end %>
      <% end %>
      <%= link_to admin_contracts_path(alert: "expired"),
            class: "rounded-md px-3 py-1.5 text-xs font-semibold flex items-center gap-1 #{@alert_filter == "expired" ? "bg-white shadow text-rose-700" : "text-slate-500 hover:text-slate-700"}" do %>
        期限切れ未処理
        <% if @summary[:already_expired] > 0 %>
          <span class="rounded-full bg-rose-100 px-1.5 text-[10px] font-bold text-rose-700"><%= @summary[:already_expired] %></span>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @contracts.any? %>
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">状態</th>
            <th class="px-4 py-2">契約番号</th>
            <th class="px-4 py-2">件名</th>
            <th class="px-4 py-2">区分</th>
            <th class="px-4 py-2">相手先</th>
            <th class="px-4 py-2">契約期間</th>
            <th class="px-4 py-2 text-right">金額</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @contracts.each do |contract| %>
            <% days = contract.days_until_expiry %>
            <% row_bg = contract.expired? && contract.status_active? ? "bg-rose-50" :
                        days && days <= 7 && contract.status_active? ? "bg-amber-50" : "" %>
            <tr class="hover:bg-slate-50 <%= row_bg %>">
              <td class="px-4 py-2"><%= contract_status_badge(contract) %></td>
              <td class="px-4 py-2 text-xs text-slate-500 font-mono"><%= contract.contract_number %></td>
              <td class="px-4 py-2 font-semibold text-slate-900"><%= contract.title %></td>
              <td class="px-4 py-2"><%= contract_counterparty_type_badge(contract) %></td>
              <td class="px-4 py-2 text-slate-700"><%= contract.counterparty_name %></td>
              <td class="px-4 py-2 text-slate-700">
                <div class="text-xs"><%= jp_date(contract.started_on) %> 〜</div>
                <% if contract.ended_on.present? %>
                  <div class="text-xs">
                    <%= jp_date(contract.ended_on) %>
                    <% if contract.expired? && contract.status_active? %>
                      <span class="ml-1 rounded-full bg-rose-100 px-1.5 py-0.5 text-[10px] font-bold text-rose-700">期限切れ</span>
                    <% elsif days && days >= 0 && days <= Contract::ALERT_THRESHOLDS.max %>
                      <% badge_color = days <= 7 ? "rose" : days <= 14 ? "amber" : "orange" %>
                      <span class="ml-1 rounded-full bg-<%= badge_color %>-100 px-1.5 py-0.5 text-[10px] font-bold text-<%= badge_color %>-700">残<%= days %>日</span>
                    <% end %>
                  </div>
                <% else %>
                  <div class="text-xs text-slate-400">期限なし</div>
                <% end %>
              </td>
              <td class="px-4 py-2 text-right font-semibold text-slate-900">
                <% if contract.amount.present? %>¥<%= number_with_delimiter(contract.amount.to_i) %><% else %>-<% end %>
              </td>
              <td class="px-4 py-2 text-right">
                <div class="inline-flex gap-2">
                  <% if can?("admin.contracts.read") %>
                    <%= link_to "詳細", admin_contract_path(contract), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
                  <% end %>
                  <% if can?("admin.contracts.update") %>
                    <%= link_to "編集", edit_admin_contract_path(contract), class: "rounded border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "shared/pagy", pagy: @pagy %>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <p>契約が登録されていません。</p>
      <% if can?("admin.contracts.create") %>
        <div class="mt-3">
          <%= link_to "最初の契約を登録する", new_admin_contract_path, class: "inline-flex items-center rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
