<%= form_with model: [:admin, contract], local: true, class: "space-y-6",
    data: { controller: "contract-form" } do |f| %>
  <% if contract.errors.any? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
      <p class="font-semibold">入力内容にエラーがあります。</p>
      <ul class="list-disc pl-5">
        <% contract.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label class="block text-sm font-medium text-slate-800">
        契約番号
        <span class="ml-1 rounded bg-rose-100 px-1.5 py-0.5 text-[10px] font-semibold text-rose-600">必須</span>
      </label>
      <%= f.text_field :contract_number, placeholder: "例: CT-2026-001",
          class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :status, "状態", class: "block text-sm font-medium text-slate-800" %>
      <%= f.select :status, options_for_select(contract_status_options, contract.status), {},
          class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium text-slate-800">
      件名
      <span class="ml-1 rounded bg-rose-100 px-1.5 py-0.5 text-[10px] font-semibold text-rose-600">必須</span>
    </label>
    <%= f.text_field :title, placeholder: "例: 業務委託契約",
        class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
  </div>

  <div>
    <div class="flex items-center gap-2">
      <%= f.label :counterparty_type, "契約区分", class: "text-sm font-medium text-slate-800" %>
      <span class="rounded bg-rose-100 px-1.5 py-0.5 text-[10px] font-semibold text-rose-600">必須</span>
    </div>
    <div class="mt-2 flex flex-wrap gap-3">
      <% contract_counterparty_type_options.each do |label, value| %>
        <label class="flex cursor-pointer items-center gap-2 rounded-lg border px-4 py-2 text-sm font-medium transition
          has-[:checked]:border-sky-500 has-[:checked]:bg-sky-50 has-[:checked]:text-sky-700
          border-slate-200 text-slate-700 hover:bg-slate-50">
          <%= f.radio_button :counterparty_type, value,
              class: "accent-sky-600",
              data: { action: "change->contract-form#onTypeChange" } %>
          <%= label %>
        </label>
      <% end %>
    </div>
  </div>

  <div data-contract-form-target="customerField"
       class="<%= 'hidden' unless contract.counterparty_type_customer? || contract.counterparty_type.blank? %>">
    <label class="block text-sm font-medium text-slate-800">
      得意先
      <span class="ml-1 rounded bg-rose-100 px-1.5 py-0.5 text-[10px] font-semibold text-rose-600">必須</span>
    </label>
    <%= f.collection_select :customer_id, @customer_options, :id, :name,
        { include_blank: "選択してください" },
        class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
  </div>

  <div data-contract-form-target="supplierField"
       class="<%= 'hidden' unless contract.counterparty_type_supplier? %>">
    <label class="block text-sm font-medium text-slate-800">
      仕入先
      <span class="ml-1 rounded bg-rose-100 px-1.5 py-0.5 text-[10px] font-semibold text-rose-600">必須</span>
    </label>
    <%= f.collection_select :supplier_id, @supplier_options, :id, :name,
        { include_blank: "選択してください" },
        class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label class="block text-sm font-medium text-slate-800">
        契約開始日
        <span class="ml-1 rounded bg-rose-100 px-1.5 py-0.5 text-[10px] font-semibold text-rose-600">必須</span>
      </label>
      <%= f.date_field :started_on, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :ended_on, "契約終了日", class: "block text-sm font-medium text-slate-800" %>
      <%= f.date_field :ended_on, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      <p class="mt-1 text-xs text-slate-500">空欄の場合は期限なし</p>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :amount, "契約金額（円）", class: "block text-sm font-medium text-slate-800" %>
      <%= f.number_field :amount, min: 0, step: 1,
          class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm",
          placeholder: "例: 1000000" %>
    </div>
    <div class="flex items-center gap-3 pt-6">
      <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 has-[:checked]:border-sky-500 has-[:checked]:bg-sky-50 has-[:checked]:text-sky-700">
        <%= f.check_box :auto_renewal, class: "accent-sky-600" %>
        自動更新あり
      </label>
    </div>
  </div>

  <div>
    <%= f.label :description, "内容", class: "block text-sm font-medium text-slate-800" %>
    <%= f.text_area :description, rows: 4,
        class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm",
        placeholder: "契約内容・条件などを記入してください" %>
  </div>

  <div>
    <%= f.label :note, "備考", class: "block text-sm font-medium text-slate-800" %>
    <%= f.text_area :note, rows: 2, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit "保存する", class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
    <%= link_to "キャンセル", contract.persisted? ? admin_contract_path(contract) : admin_contracts_path,
        class: "text-sm text-slate-600 hover:text-slate-800" %>
  </div>
<% end %>
