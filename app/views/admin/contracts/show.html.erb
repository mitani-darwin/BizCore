<% content_for :page_title, "契約詳細" %>

<div class="space-y-4">
  <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-xl font-semibold text-slate-900"><%= @contract.title %></h1>
        <%= contract_status_badge(@contract) %>
        <%= contract_counterparty_type_badge(@contract) %>
      </div>
      <p class="text-sm text-slate-500 font-mono mt-1"><%= @contract.contract_number %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if can?("admin.contracts.update") %>
        <%= link_to "編集", edit_admin_contract_path(@contract), class: "rounded border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
      <% end %>
      <%= link_to "一覧へ戻る", admin_contracts_path, class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">契約金額</div>
      <% if @contract.amount.present? %>
        <div class="mt-2 text-2xl font-bold text-slate-900">¥<%= number_with_delimiter(@contract.amount.to_i) %></div>
      <% else %>
        <div class="mt-2 text-sm text-slate-400">未設定</div>
      <% end %>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">契約期間</div>
      <div class="mt-2 text-sm font-semibold text-slate-900">
        <%= jp_date(@contract.started_on) %> 〜
        <% if @contract.ended_on.present? %>
          <%= jp_date(@contract.ended_on) %>
          <% days = @contract.days_until_expiry %>
          <% if days && days >= 0 %>
            <div class="mt-1 text-xs <%= days <= 30 ? 'text-amber-600 font-semibold' : 'text-slate-500' %>">
              あと <%= days %> 日
            </div>
          <% elsif days && days < 0 %>
            <div class="mt-1 text-xs text-rose-600 font-semibold"><%= days.abs %> 日前に期限切れ</div>
          <% end %>
        <% else %>
          <span class="text-slate-400">（期限なし）</span>
        <% end %>
      </div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">自動更新</div>
      <div class="mt-2 text-sm font-semibold text-slate-900">
        <%= @contract.auto_renewal? ? "あり" : "なし" %>
      </div>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900">契約情報</h2>
    <dl class="mt-3 grid gap-4 text-sm text-slate-800 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">契約区分</dt>
        <dd class="mt-1"><%= contract_counterparty_type_label(@contract.counterparty_type) %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">相手先</dt>
        <dd class="mt-1">
          <% if @contract.customer.present? %>
            <%= link_to @contract.customer.name, admin_customer_path(@contract.customer), class: "text-sky-700 hover:underline" %>
          <% elsif @contract.supplier.present? %>
            <%= link_to @contract.supplier.name, admin_supplier_path(@contract.supplier), class: "text-sky-700 hover:underline" %>
          <% else %>
            -
          <% end %>
        </dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-xs text-slate-500">内容</dt>
        <dd class="mt-1 whitespace-pre-line rounded-lg border border-slate-100 bg-slate-50 px-4 py-3 text-sm">
          <%= @contract.description.presence || "-" %>
        </dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-xs text-slate-500">備考</dt>
        <dd class="mt-1 text-sm"><%= @contract.note.presence || "-" %></dd>
      </div>
    </dl>
  </div>
</div>
