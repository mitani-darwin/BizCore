<% content_for :page_title, "勤怠詳細" %>

<div class="space-y-4">
  <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-xl font-semibold text-slate-900"><%= @attendance_record.employee.name %> / <%= jp_date(@attendance_record.work_date) %></h1>
        <%= attendance_status_badge(@attendance_record) %>
      </div>
      <p class="text-sm text-slate-600">出勤 <%= jp_datetime(@attendance_record.clock_in_at) %> / 退勤 <%= jp_datetime(@attendance_record.clock_out_at) %></p>
    </div>
    <div class="flex gap-2">
      <% if can?("admin.attendance_records.update") %>
        <%= link_to "編集", edit_admin_attendance_record_path(@attendance_record), class: "rounded border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
      <% end %>
      <%= link_to "一覧へ戻る", admin_attendance_records_path(month: @attendance_record.work_date.strftime("%Y-%m")), class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">実働</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= minutes_to_hours(@attendance_record.worked_minutes) %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">残業</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= minutes_to_hours(@attendance_record.overtime_minutes) %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">休憩</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= @attendance_record.break_minutes %> 分</div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">シフト差分</div>
      <div class="mt-2 text-3xl font-bold text-slate-900">
        <% scheduled_minutes = @attendance_record.work_shift&.scheduled_minutes || @attendance_record.employee.standard_daily_minutes %>
        <%= signed_minutes(@attendance_record.worked_minutes - scheduled_minutes) %>
      </div>
    </div>
  </div>

  <div class="grid gap-4 xl:grid-cols-[1fr_380px]">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-900">勤怠情報</h2>
      <dl class="mt-3 grid gap-4 text-sm text-slate-800 sm:grid-cols-2">
        <div>
          <dt class="text-xs text-slate-500">従業員</dt>
          <dd><%= link_to @attendance_record.employee.title, admin_employee_path(@attendance_record.employee), class: "text-sky-700 hover:underline" %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">勤務日</dt>
          <dd><%= jp_date(@attendance_record.work_date) %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">出勤時刻</dt>
          <dd><%= jp_datetime(@attendance_record.clock_in_at) %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">退勤時刻</dt>
          <dd><%= jp_datetime(@attendance_record.clock_out_at) %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">連携シフト</dt>
          <dd>
            <% if @attendance_record.work_shift.present? %>
              <%= link_to "#{jp_date(@attendance_record.work_shift.work_date)} #{hhmm(@attendance_record.work_shift.start_time)} - #{hhmm(@attendance_record.work_shift.end_time)}", admin_work_shift_path(@attendance_record.work_shift), class: "text-sky-700 hover:underline" %>
            <% else %>
              -
            <% end %>
          </dd>
        </div>
        <div class="sm:col-span-2">
          <dt class="text-xs text-slate-500">備考</dt>
          <dd><%= @attendance_record.note.presence || "-" %></dd>
        </div>
      </dl>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-900">2. 退勤確定</h2>
      <% if @attendance_record.working? && can?("admin.attendance_records.update") %>
        <% default_clock_out_at = Time.zone.now.change(sec: 0) %>
        <%= form_with scope: :attendance_record, url: clock_out_admin_attendance_record_path(@attendance_record), method: :patch, local: true, class: "mt-4 space-y-3" do |f| %>
          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label class="block text-xs font-semibold tracking-wide text-slate-500">退勤日</label>
              <%= date_field_tag "attendance_record[clock_out_on]", default_clock_out_at.to_date, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
            </div>
            <div>
              <label class="block text-xs font-semibold tracking-wide text-slate-500">退勤時刻</label>
              <%= time_field_tag "attendance_record[clock_out_time]", default_clock_out_at.strftime("%H:%M"), class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
            </div>
            <div>
              <label class="block text-xs font-semibold tracking-wide text-slate-500">休憩時間（分）</label>
              <%= f.number_field :break_minutes, value: @attendance_record.break_minutes, min: 0, step: 1, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold tracking-wide text-slate-500">メモ</label>
            <%= text_area_tag "attendance_record[note]", @attendance_record.note, rows: 3, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
          </div>
          <%= f.submit "退勤を確定", class: "rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700" %>
        <% end %>
      <% elsif @attendance_record.closed? %>
        <p class="mt-3 text-sm text-slate-500">この勤怠は勤務確定済みです。</p>
      <% else %>
        <p class="mt-3 text-sm text-slate-500">出勤打刻前のため、退勤確定はできません。</p>
      <% end %>
    </div>
  </div>
</div>
