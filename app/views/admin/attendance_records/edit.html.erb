<% content_for :page_title, "勤怠編集" %>

<div class="space-y-4">
  <div>
    <h1 class="text-xl font-semibold text-slate-900">勤怠編集</h1>
    <p class="text-sm text-slate-600"><%= @attendance_record.employee.name %> / <%= jp_date(@attendance_record.work_date) %> の勤怠を修正します。</p>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= render "form", attendance_record: @attendance_record %>
  </div>
</div>
