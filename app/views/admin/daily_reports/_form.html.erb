<%= form_with model: [:admin, daily_report], local: true, class: "space-y-6" do |f| %>
  <% if daily_report.errors.any? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
      <p class="font-semibold">入力内容にエラーがあります。</p>
      <ul class="list-disc pl-5">
        <% daily_report.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :employee_id, "従業員", class: "block text-sm font-medium text-slate-800" %>
      <%= f.collection_select :employee_id, @employee_options, :id, :name,
          { include_blank: "選択してください" },
          class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
    </div>
    <div>
      <%= f.label :site_id, "現場", class: "block text-sm font-medium text-slate-800" %>
      <%= f.collection_select :site_id, @site_options, :id, :name,
          { include_blank: "選択してください" },
          class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
    </div>
    <div>
      <%= f.label :report_date, "作業日", class: "block text-sm font-medium text-slate-800" %>
      <%= f.date_field :report_date, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
    </div>
    <div>
      <%= f.label :work_hours, "作業時間（時間）", class: "block text-sm font-medium text-slate-800" %>
      <%= f.number_field :work_hours, min: 0.5, step: 0.5,
          class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
    </div>
  </div>

  <div>
    <%= f.label :work_content, "作業内容", class: "block text-sm font-medium text-slate-800" %>
    <%= f.text_area :work_content, rows: 5,
        class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500",
        placeholder: "本日の作業内容を記入してください" %>
  </div>

  <div>
    <%= f.label :notes, "備考", class: "block text-sm font-medium text-slate-800" %>
    <%= f.text_area :notes, rows: 3,
        class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500",
        placeholder: "特記事項があれば記入してください" %>
  </div>

  <div>
    <%= f.label :photos, "写真", class: "block text-sm font-medium text-slate-800" %>
    <%= f.file_field :photos, multiple: true, accept: "image/*",
        class: "mt-1 block text-sm text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-sky-50 file:px-3 file:py-1.5 file:text-sm file:font-semibold file:text-sky-700 hover:file:bg-sky-100" %>
    <% if daily_report.persisted? && daily_report.photos.attached? %>
      <div class="mt-2 grid grid-cols-4 gap-2">
        <% daily_report.photos.each do |photo| %>
          <div class="overflow-hidden rounded-lg border border-slate-200">
            <%= image_tag photo, class: "h-20 w-full object-cover" %>
          </div>
        <% end %>
      </div>
      <p class="mt-1 text-xs text-slate-500">新たにファイルを選択すると既存の写真は上書きされます。</p>
    <% end %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit daily_report.persisted? ? "更新する" : "登録する",
        class: "rounded-lg bg-sky-600 px-6 py-2 text-sm font-semibold text-white hover:bg-sky-700 cursor-pointer" %>
    <%= link_to "キャンセル",
        daily_report.persisted? ? admin_daily_report_path(daily_report) : admin_daily_reports_path,
        class: "text-sm text-slate-600 hover:text-slate-800" %>
  </div>
<% end %>
