<% content_for :page_title, "日報登録" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">日報登録</h1>
      <p class="text-sm text-slate-600">新しい日報を登録します。</p>
    </div>
    <%= link_to "一覧へ戻る", admin_daily_reports_path,
        class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= render "form", daily_report: @daily_report %>
  </div>
</div>
