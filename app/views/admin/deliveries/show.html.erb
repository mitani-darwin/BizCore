<% content_for :page_title, "納品詳細" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-xl font-semibold text-slate-900"><%= @delivery.delivery_number %></h1>
        <%= delivery_status_badge(@delivery) %>
      </div>
      <p class="text-sm text-slate-600"><%= @delivery.customer.name %> / 納品日 <%= jp_date(@delivery.delivery_date) %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Excel出力", download_excel_admin_delivery_path(@delivery), class: "rounded border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-100" %>
      <%= link_to "注文へ", admin_order_path(@delivery.order), class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-900">納品情報</h2>
      <dl class="mt-3 space-y-3 text-sm text-slate-800">
        <div>
          <dt class="text-xs text-slate-500">注文番号</dt>
          <dd><%= link_to @delivery.order.order_number, admin_order_path(@delivery.order), class: "text-sky-700 hover:underline" %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">納品先住所</dt>
          <dd><%= @delivery.delivery_address.presence || "-" %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">備考</dt>
          <dd><%= @delivery.remarks.presence || "-" %></dd>
        </div>
      </dl>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-900">金額</h2>
      <div class="mt-3 text-3xl font-bold text-slate-900"><%= money(@delivery.total_amount) %></div>
      <div class="mt-2 text-xs text-slate-500">発行日時 <%= @delivery.issued_at.present? ? @delivery.issued_at.strftime("%Y/%m/%d %H:%M") : "-" %></div>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 px-4 py-3">
      <h2 class="text-sm font-semibold text-slate-900">納品明細</h2>
    </div>
    <table class="min-w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="px-4 py-2">商品</th>
          <th class="px-4 py-2">数量</th>
          <th class="px-4 py-2">単価</th>
          <th class="px-4 py-2">金額</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @delivery.delivery_items.each do |item| %>
          <tr>
            <td class="px-4 py-2 text-slate-700">
              <div class="font-semibold text-slate-900"><%= item.product_name_snapshot %></div>
              <div class="text-xs text-slate-500"><%= item.product_code_snapshot %></div>
            </td>
            <td class="px-4 py-2 text-slate-700"><%= item.delivered_quantity %> <%= item.unit_name_snapshot %></td>
            <td class="px-4 py-2 text-slate-700"><%= money(item.unit_price) %></td>
            <td class="px-4 py-2 text-slate-700"><%= money(item.amount) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="flex gap-2">
    <%= link_to "一覧へ戻る", admin_deliveries_path, class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
    <%= link_to "注文へ", admin_order_path(@delivery.order), class: "rounded border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
  </div>
</div>
