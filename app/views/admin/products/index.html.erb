<% content_for :page_title, "商品一覧" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">商品一覧</h1>
      <p class="text-sm text-slate-600">注文・納品・請求で使用する商品マスタです。</p>
    </div>
    <% if can?("admin.products.create") %>
      <div class="flex items-center gap-2">
        <%= link_to "CSVインポート", import_admin_products_path, class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
        <%= link_to "新規商品", new_admin_product_path, class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      </div>
    <% end %>
  </div>

  <% if @products.any? %>
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">コード</th>
            <th class="px-4 py-2">商品名</th>
            <th class="px-4 py-2">単価</th>
            <th class="px-4 py-2">税区分</th>
            <th class="px-4 py-2">状態</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @products.each do |product| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2 font-semibold text-slate-900"><%= product.code %></td>
              <td class="px-4 py-2 text-slate-700">
                <div class="font-semibold text-slate-900"><%= product.name %></div>
                <div class="text-xs text-slate-500">単位: <%= product.unit_name %></div>
              </td>
              <td class="px-4 py-2 text-slate-700"><%= money(product.standard_price) %></td>
              <td class="px-4 py-2 text-slate-700"><%= tax_category_label(product.tax_category) %></td>
              <td class="px-4 py-2"><%= active_badge(product.active) %></td>
              <td class="px-4 py-2 text-right">
                <div class="inline-flex gap-2">
                  <%= link_to "詳細", admin_product_path(product), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
                  <% if can?("admin.products.update") %>
                    <%= link_to "編集", edit_admin_product_path(product), class: "rounded border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "shared/pagy", pagy: @pagy %>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <p>商品がまだ登録されていません。</p>
    </div>
  <% end %>
</div>
