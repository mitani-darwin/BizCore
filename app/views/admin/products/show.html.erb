<% content_for :page_title, "商品詳細" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-slate-900"><%= @product.name %></h1>
      <p class="text-sm text-slate-600">コード: <%= @product.code %></p>
    </div>
    <% if can?("admin.products.update") %>
      <%= link_to "編集", edit_admin_product_path(@product), class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
    <% end %>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-900">商品情報</h2>
      <dl class="mt-3 space-y-3 text-sm text-slate-800">
        <div>
          <dt class="text-xs text-slate-500">単位</dt>
          <dd><%= @product.unit_name %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">標準単価</dt>
          <dd><%= money(@product.standard_price) %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">税区分</dt>
          <dd><%= tax_category_label(@product.tax_category) %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">状態</dt>
          <dd><%= active_badge(@product.active) %></dd>
        </div>
      </dl>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-900">在庫状況</h2>
      <% if @product.stock_items.any? %>
        <div class="mt-3 space-y-2">
          <% @product.stock_items.includes(:warehouse).each do |stock_item| %>
            <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3 text-sm text-slate-700">
              <div class="font-semibold text-slate-900"><%= stock_item.warehouse.name %></div>
              <div class="mt-1 text-xs text-slate-500">
                在庫 <%= stock_item.quantity_on_hand %> / 引当 <%= stock_item.quantity_reserved %> / 利用可能 <%= stock_item.available_quantity %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="mt-3 text-sm text-slate-500">在庫登録はまだありません。</p>
      <% end %>
    </div>
  </div>

  <% if @product.note.present? %>
    <div class="rounded-xl border border-slate-200 bg-white p-5 text-sm text-slate-700 shadow-sm">
      <div class="mb-1 text-xs text-slate-500">備考</div>
      <%= simple_format(@product.note) %>
    </div>
  <% end %>

  <div class="flex gap-2">
    <%= link_to "一覧へ戻る", admin_products_path, class: "rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
    <% if can?("admin.products.update") %>
      <%= link_to "編集", edit_admin_product_path(@product), class: "rounded border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
    <% end %>
  </div>
</div>
