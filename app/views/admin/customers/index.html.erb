<% content_for :page_title, "得意先一覧" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">得意先一覧</h1>
      <p class="text-sm text-slate-600">注文・請求・入金に使う得意先マスタです。</p>
    </div>
    <% if can?("admin.customers.create") %>
      <%= link_to "新規得意先", new_admin_customer_path, class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
    <% end %>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: admin_customers_path, method: :get, local: true, class: "grid gap-3 md:grid-cols-[minmax(0,2fr)_220px_auto_auto]" do |f| %>
      <div>
        <%= f.label :q, "検索", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.text_field :q, value: @filters[:q], placeholder: "コード・得意先名・担当者名・メールで検索", class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
      </div>
      <div>
        <%= f.label :status, "取引状態", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.select :status, options_for_select([["すべて", ""]] + customer_status_options, @filters[:status]), {}, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
      </div>
      <div class="flex items-end">
        <%= f.submit "絞り込む", class: "w-full rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      </div>
      <div class="flex items-end">
        <%= link_to "条件をクリア", admin_customers_path, class: "w-full rounded-lg border border-slate-200 bg-white px-4 py-2 text-center text-sm text-slate-700 hover:bg-slate-50" %>
      </div>
    <% end %>

    <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">対象得意先</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @customer_summary[:count] %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">取引中</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @customer_summary[:active_count] %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">未入金請求</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @customer_summary[:unpaid_invoice_count] %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">売掛残高</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= money(@customer_summary[:outstanding_amount]) %></div>
      </div>
    </div>
  </div>

  <% if @customers.any? %>
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">状態</th>
            <th class="px-4 py-2">コード</th>
            <th class="px-4 py-2">得意先名</th>
            <th class="px-4 py-2">担当者</th>
            <th class="px-4 py-2">請求条件</th>
            <th class="px-4 py-2 text-right">売掛残高</th>
            <th class="px-4 py-2">最終注文</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @customers.each do |customer| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2"><%= customer_status_badge(customer) %></td>
              <td class="px-4 py-2 font-semibold text-slate-900"><%= customer.code %></td>
              <td class="px-4 py-2 text-slate-700">
                <div class="font-semibold text-slate-900"><%= customer.name %></div>
                <div class="text-xs text-slate-500"><%= customer.email.presence || "メール未設定" %></div>
              </td>
              <td class="px-4 py-2 text-slate-700">
                <div><%= customer.primary_contact.presence || "未設定" %></div>
                <div class="text-xs text-slate-500"><%= customer.contact_person_email.presence || customer.contact_person_tel.presence || "-" %></div>
              </td>
              <td class="px-4 py-2 text-slate-700">
                <div><%= customer.closing_day.present? ? "#{customer.closing_day}日締め" : "締日未設定" %></div>
                <div class="text-xs text-slate-500"><%= invoice_delivery_method_label(customer.invoice_delivery_method) %> / <%= payment_method_label(customer.payment_method) %></div>
              </td>
              <td class="px-4 py-2 text-right text-slate-700">
                <div class="font-semibold text-slate-900"><%= money(customer.outstanding_invoice_amount) %></div>
                <div class="text-xs text-slate-500">未入金 <%= customer.unpaid_invoice_count %> 件</div>
              </td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(customer.last_order_date) %></td>
              <td class="px-4 py-2 text-right">
                <div class="inline-flex gap-2">
                  <%= link_to "詳細", admin_customer_path(customer), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
                  <% if can?("admin.customers.update") %>
                    <%= link_to "編集", edit_admin_customer_path(customer), class: "rounded border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "shared/pagy", pagy: @pagy %>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <p><%= @filters[:q].present? || @filters[:status].present? ? "条件に一致する得意先がありません。" : "得意先がまだ登録されていません。" %></p>
    </div>
  <% end %>
</div>
