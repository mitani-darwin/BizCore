<% content_for :page_title, "得意先一覧" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">得意先一覧</h1>
      <p class="text-sm text-slate-600">注文・請求・入金に使う得意先マスタです。</p>
    </div>
    <% if can?("admin.customers.create") %>
      <%= link_to "新規得意先", new_admin_customer_path, class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
    <% end %>
  </div>

  <% if @customers.any? %>
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">コード</th>
            <th class="px-4 py-2">得意先名</th>
            <th class="px-4 py-2">締日</th>
            <th class="px-4 py-2">請求書送付</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @customers.each do |customer| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2 font-semibold text-slate-900"><%= customer.code %></td>
              <td class="px-4 py-2 text-slate-700">
                <div class="font-semibold text-slate-900"><%= customer.name %></div>
                <div class="text-xs text-slate-500"><%= customer.email.presence || "メール未設定" %></div>
              </td>
              <td class="px-4 py-2 text-slate-700"><%= customer.closing_day.present? ? "#{customer.closing_day}日" : "-" %></td>
              <td class="px-4 py-2 text-slate-700"><%= invoice_delivery_method_label(customer.invoice_delivery_method) %></td>
              <td class="px-4 py-2 text-right">
                <div class="inline-flex gap-2">
                  <%= link_to "詳細", admin_customer_path(customer), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
                  <% if can?("admin.customers.update") %>
                    <%= link_to "編集", edit_admin_customer_path(customer), class: "rounded border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <p>得意先がまだ登録されていません。</p>
    </div>
  <% end %>
</div>
