<% content_for :page_title, "ロール付与" %>

<div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8">
  <div class="mb-6 rounded-2xl border border-slate-200 bg-gradient-to-r from-slate-900 via-slate-800 to-slate-700 px-6 py-5 text-white shadow-lg">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-xs font-semibold tracking-wide text-slate-200 uppercase">ユーザー別ロール管理</p>
        <h1 class="text-2xl font-bold leading-tight">ロール付与</h1>
        <p class="mt-1 text-sm text-slate-200">
          ユーザーに対してロールを割り当てます。チェックを入れて保存すると Assignment が登録されます。
        </p>
      </div>
      <div class="flex flex-col items-start gap-2 sm:items-end">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white ring-1 ring-white/30">
          テナント: <%= current_tenant&.name || "未設定" %>
        </span>
      </div>
    </div>
  </div>

  <div class="mb-4 grid gap-3 sm:grid-cols-2">
    <div class="rounded-xl border border-slate-200 bg-white/90 px-4 py-3 shadow-sm">
      <p class="text-sm font-semibold text-slate-800">運用上の前提</p>
      <ul class="mt-2 space-y-1 text-xs text-slate-600">
        <li>・チェックを保存すると、ユーザーとロールの紐付け（Assignment）が作成されます。</li>
        <li>・外したチェックは保存時に Assignment が削除されます。</li>
        <li>・オーナーユーザーはロールに関係なく全権を持ちます。</li>
      </ul>
    </div>
    <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 shadow-sm text-xs text-amber-800">
      <p class="text-sm font-semibold">安全装置</p>
      <ul class="mt-1 space-y-1">
        <li>・更新はトランザクションで実行します。</li>
        <li>・他テナントのユーザー・ロールは対象外です。</li>
        <li>・ロール付与権限がなければ、この画面にはアクセスできません。</li>
      </ul>
    </div>
  </div>

  <% if @users.empty? %>
    <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-600 shadow-sm">
      このテナントにユーザーが存在しません。先にユーザーを作成してください。
    </div>
  <% elsif @roles.empty? %>
    <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-600 shadow-sm">
      このテナントにロールが存在しません。先にロールを作成してください。
    </div>
  <% else %>
    <%= form_with url: admin_assignments_path, method: :post, local: true do %>
      <div class="mb-4 flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold uppercase text-slate-500">ユーザー × ロール マトリクス</p>
          <p class="text-sm text-slate-700">チェックを入れて保存すると、対応する Assignment が登録されます。</p>
        </div>
        <% if can?("admin.assignments.create") %>
          <%= submit_tag "付与を保存", class: "inline-flex items-center rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-sky-700" %>
        <% end %>
      </div>

      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="overflow-x-auto">
          <table class="min-w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
              <tr>
                <th class="px-4 py-3 font-medium">ユーザー</th>
                <th class="px-4 py-3 font-medium text-slate-400">メール</th>
                <% @roles.each do |role| %>
                  <th class="px-3 py-3 text-center font-medium"><%= role.name %></th>
                <% end %>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @users.each do |user| %>
                <tr class="hover:bg-slate-50">
                  <td class="px-4 py-3 align-middle">
                    <div class="flex items-center gap-2">
                      <span class="font-semibold text-slate-900"><%= user.name %></span>
                      <% if user.is_owner? %>
                        <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-700">オーナー</span>
                      <% end %>
                    </div>
                  </td>
                  <td class="px-4 py-3 align-middle text-xs text-slate-500"><%= user.email %></td>
                  <% @roles.each do |role| %>
                    <td class="px-3 py-3 text-center align-middle">
                      <div class="inline-flex items-center justify-center rounded-md border border-slate-200 bg-white px-2 py-1">
                        <%= check_box_tag "assignments[#{user.id}][]",
                            role.id,
                            @assignments.include?([user.id, role.id]),
                            disabled: !can?("admin.assignments.create"),
                            class: "h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500" %>
                      </div>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <% if can?("admin.assignments.create") %>
        <div class="mt-4 flex justify-end">
          <%= submit_tag "付与を保存", class: "inline-flex items-center rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-sky-700" %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
