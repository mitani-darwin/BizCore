<% content_for :page_title, "返品/値引き一覧" %>

<div class="space-y-4">
  <div>
    <h1 class="text-xl font-semibold text-slate-900">返品/値引き一覧</h1>
    <p class="text-sm text-slate-600">入荷後に発生した返品と仕入値引きを履歴で管理します。</p>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: admin_purchase_adjustments_path, method: :get, local: true, class: "grid gap-3 xl:grid-cols-[minmax(0,2fr)_220px_240px_auto_auto]" do |f| %>
      <div>
        <%= f.label :q, "検索", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.text_field :q, value: @filters[:q], placeholder: "調整番号・入荷番号・仕入先・商品名で検索", class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :adjustment_type, "区分", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.select :adjustment_type, options_for_select([["すべて", ""]] + purchase_adjustment_type_options, @filters[:adjustment_type]), {}, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :supplier_id, "仕入先", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.collection_select :supplier_id, @supplier_filter_options, :id, :name, { include_blank: "すべて", selected: @filters[:supplier_id] }, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      </div>
      <div class="flex items-end">
        <%= f.submit "絞り込む", class: "w-full rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      </div>
      <div class="flex items-end">
        <%= link_to "条件をクリア", admin_purchase_adjustments_path, class: "w-full rounded-lg border border-slate-200 bg-white px-4 py-2 text-center text-sm text-slate-700 hover:bg-slate-50" %>
      </div>
    <% end %>

    <div class="mt-4 grid gap-3 md:grid-cols-3">
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">対象件数</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @summary[:count] %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">返品金額合計</div>
        <div class="mt-1 text-xl font-semibold text-rose-700"><%= @summary[:return_amount].positive? ? "-#{money(@summary[:return_amount])}" : money(0) %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">値引金額合計</div>
        <div class="mt-1 text-xl font-semibold text-amber-700"><%= @summary[:discount_amount].positive? ? "-#{money(@summary[:discount_amount])}" : money(0) %></div>
      </div>
    </div>
  </div>

  <% if @purchase_adjustments.any? %>
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">調整番号</th>
            <th class="px-4 py-2">区分</th>
            <th class="px-4 py-2">仕入先</th>
            <th class="px-4 py-2">対象入荷</th>
            <th class="px-4 py-2">商品</th>
            <th class="px-4 py-2">調整日</th>
            <th class="px-4 py-2">金額</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @purchase_adjustments.each do |adjustment| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2 font-semibold text-slate-900"><%= adjustment.adjustment_number %></td>
              <td class="px-4 py-2"><%= purchase_adjustment_status_badge(adjustment) %></td>
              <td class="px-4 py-2 text-slate-700"><%= adjustment.supplier.name %></td>
              <td class="px-4 py-2 text-slate-700">
                <%= link_to adjustment.purchase_receipt.purchase_receipt_number, admin_purchase_receipt_path(adjustment.purchase_receipt), class: "hover:underline" %>
              </td>
              <td class="px-4 py-2 text-slate-700"><%= adjustment.product_name_snapshot.presence || "入荷全体値引き" %></td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(adjustment.adjustment_date) %></td>
              <td class="px-4 py-2 font-semibold <%= adjustment.purchase_return? ? 'text-rose-700' : 'text-amber-700' %>"><%= purchase_adjustment_signed_amount(adjustment) %></td>
              <td class="px-4 py-2 text-right">
                <%= link_to "詳細", admin_purchase_adjustment_path(adjustment), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <p><%= @filters[:q].present? || @filters[:adjustment_type].present? || @filters[:supplier_id].present? ? "条件に一致する返品/値引きがありません。" : "返品/値引きはまだ登録されていません。" %></p>
    </div>
  <% end %>
</div>
