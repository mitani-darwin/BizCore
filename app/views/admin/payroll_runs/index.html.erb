<% content_for :page_title, "給与計算一覧" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">給与計算一覧</h1>
      <p class="text-sm text-slate-600">4. シフト、1. 出退勤、2. 残業、3. 有給を集計して 5. 給与へ自動反映します。</p>
    </div>
  </div>

  <% if can?("admin.payroll_runs.create") %>
    <div class="rounded-xl border border-violet-200 bg-violet-50 p-4 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-900">5. 給与への自動反映</h2>
      <p class="mt-1 text-xs text-slate-600">対象月の勤務確定済み勤怠、残業、有給承認分を集計して給与計算を再生成します。確定済みの月は再生成できません。</p>
      <%= form_with url: generate_admin_payroll_runs_path, method: :post, local: true, class: "mt-3 grid gap-3 md:grid-cols-[180px_minmax(0,1fr)_auto]" do %>
        <div>
          <label class="block text-xs font-semibold tracking-wide text-slate-500">給与対象月</label>
          <%= month_field_tag :payroll_month, @current_month.strftime("%Y-%m"), class: "mt-1 w-full rounded-lg border border-violet-200 bg-white px-3 py-2 text-sm" %>
        </div>
        <div>
          <label class="block text-xs font-semibold tracking-wide text-slate-500">メモ</label>
          <%= text_field_tag :note, nil, placeholder: "例: 2026年4月給与", class: "mt-1 w-full rounded-lg border border-violet-200 bg-white px-3 py-2 text-sm" %>
        </div>
        <div class="flex items-end">
          <%= submit_tag "給与へ反映", class: "w-full rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-700" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">計算回数</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= @payroll_summary[:count] %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">最新支給総額</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= money(@payroll_summary[:latest_total_gross_pay]) %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs text-slate-500">最新対象人数</div>
      <div class="mt-2 text-3xl font-bold text-slate-900"><%= @payroll_summary[:latest_employee_count] %></div>
    </div>
  </div>

  <% if @payroll_runs.any? %>
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">状態</th>
            <th class="px-4 py-2">給与計算番号</th>
            <th class="px-4 py-2">対象月</th>
            <th class="px-4 py-2">生成日時</th>
            <th class="px-4 py-2">確定日時</th>
            <th class="px-4 py-2 text-right">対象人数</th>
            <th class="px-4 py-2 text-right">支給総額</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @payroll_runs.each do |payroll_run| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2"><%= payroll_run_status_badge(payroll_run) %></td>
              <td class="px-4 py-2 font-semibold text-slate-900"><%= payroll_run.run_number %></td>
              <td class="px-4 py-2 text-slate-700"><%= payroll_run.payroll_month.strftime("%Y年%m月") %></td>
              <td class="px-4 py-2 text-slate-700"><%= jp_datetime(payroll_run.generated_at) %></td>
              <td class="px-4 py-2 text-slate-700"><%= payroll_run.confirmed_at ? jp_datetime(payroll_run.confirmed_at) : "-" %></td>
              <td class="px-4 py-2 text-right text-slate-700"><%= payroll_run.employee_count %></td>
              <td class="px-4 py-2 text-right text-slate-700"><%= money(payroll_run.total_gross_pay) %></td>
              <td class="px-4 py-2 text-right">
                <%= link_to "詳細", admin_payroll_run_path(payroll_run), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <p>給与計算はまだありません。</p>
    </div>
  <% end %>
</div>
