<% content_for :page_title, "シフト一覧" %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">シフト一覧</h1>
      <p class="text-sm text-slate-600">従業員ごとの勤務予定を月単位で管理します。</p>
    </div>
    <% if can?("admin.work_shifts.create") %>
      <%= link_to "新規シフト", new_admin_work_shift_path, class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
    <% end %>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: admin_work_shifts_path, method: :get, local: true, class: "grid gap-3 md:grid-cols-[180px_minmax(0,1fr)_auto_auto]" do |f| %>
      <div>
        <%= f.label :month, "対象月", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= month_field_tag :month, @filters[:month], class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :employee_id, "従業員", class: "block text-xs font-semibold tracking-wide text-slate-500" %>
        <%= f.collection_select :employee_id, @employee_options, :id, :title, { include_blank: "すべて" }, class: "mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" %>
      </div>
      <div class="flex items-end">
        <%= f.submit "表示", class: "w-full rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      </div>
      <div class="flex items-end">
        <%= link_to "条件をクリア", admin_work_shifts_path, class: "w-full rounded-lg border border-slate-200 bg-white px-4 py-2 text-center text-sm text-slate-700 hover:bg-slate-50" %>
      </div>
    <% end %>

    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">シフト件数</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @shift_summary[:count] %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">所定時間</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= minutes_to_hours(@shift_summary[:scheduled_minutes]) %></div>
      </div>
      <div class="rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
        <div class="text-xs text-slate-500">完了</div>
        <div class="mt-1 text-xl font-semibold text-slate-900"><%= @shift_summary[:completed_count] %></div>
      </div>
    </div>
  </div>

  <% if @work_shifts.any? %>
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-2">状態</th>
            <th class="px-4 py-2">勤務日</th>
            <th class="px-4 py-2">従業員</th>
            <th class="px-4 py-2">時間帯</th>
            <th class="px-4 py-2 text-right">所定時間</th>
            <th class="px-4 py-2">勤怠</th>
            <th class="px-4 py-2 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @work_shifts.each do |work_shift| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2"><%= work_shift_status_badge(work_shift) %></td>
              <td class="px-4 py-2 text-slate-700"><%= jp_date(work_shift.work_date) %></td>
              <td class="px-4 py-2 text-slate-700">
                <div class="font-semibold text-slate-900"><%= link_to work_shift.employee.name, admin_employee_path(work_shift.employee), class: "hover:underline" %></div>
                <div class="text-xs text-slate-500"><%= work_shift.employee.employee_code %></div>
              </td>
              <td class="px-4 py-2 text-slate-700"><%= hhmm(work_shift.start_time) %> - <%= hhmm(work_shift.end_time) %><div class="text-xs text-slate-500">休憩 <%= work_shift.break_minutes %> 分</div></td>
              <td class="px-4 py-2 text-right text-slate-700"><%= minutes_to_hours(work_shift.scheduled_minutes) %></td>
              <td class="px-4 py-2 text-slate-700">
                <% if work_shift.attendance_record.present? %>
                  <%= link_to attendance_status_label(work_shift.attendance_record.status), admin_attendance_record_path(work_shift.attendance_record), class: "text-sky-700 hover:underline" %>
                <% else %>
                  未登録
                <% end %>
              </td>
              <td class="px-4 py-2 text-right">
                <div class="inline-flex gap-2">
                  <%= link_to "詳細", admin_work_shift_path(work_shift), class: "rounded border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50" %>
                  <% if can?("admin.work_shifts.update") %>
                    <%= link_to "編集", edit_admin_work_shift_path(work_shift), class: "rounded border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
      <p>対象のシフトはありません。</p>
    </div>
  <% end %>
</div>
