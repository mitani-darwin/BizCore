<div class="bg-white border border-sky-300 rounded shadow-xl p-2 text-xs w-52 z-20">
  <% if work_shift.errors.any? %>
    <div class="mb-1.5 rounded bg-rose-50 px-2 py-1 text-rose-600">
      <%= work_shift.errors.full_messages.first %>
    </div>
  <% end %>

  <%= form_with model: [:admin, work_shift], class: "space-y-1.5" do |f| %>
    <%= hidden_field_tag :from_grid, from_grid %>
    <%= f.hidden_field :employee_id %>
    <%= f.hidden_field :work_date %>

    <div>
      <label class="block text-[10px] text-slate-500">開始</label>
      <%= f.time_field :start_time, class: "w-full rounded border border-slate-200 px-1.5 py-0.5 text-xs focus:border-sky-400 focus:outline-none" %>
    </div>
    <div>
      <label class="block text-[10px] text-slate-500">終了</label>
      <%= f.time_field :end_time, class: "w-full rounded border border-slate-200 px-1.5 py-0.5 text-xs focus:border-sky-400 focus:outline-none" %>
    </div>
    <div>
      <label class="block text-[10px] text-slate-500">休憩（分）</label>
      <%= f.number_field :break_minutes, min: 0, step: 1, class: "w-full rounded border border-slate-200 px-1.5 py-0.5 text-xs focus:border-sky-400 focus:outline-none" %>
    </div>
    <div>
      <label class="block text-[10px] text-slate-500">状態</label>
      <%= f.select :status, options_for_select(work_shift_status_options, work_shift.status), {},
          class: "w-full rounded border border-slate-200 px-1.5 py-0.5 text-xs focus:border-sky-400 focus:outline-none" %>
    </div>

    <div class="flex gap-1 pt-0.5">
      <%= f.submit "保存", class: "flex-1 rounded bg-sky-600 px-2 py-1 text-xs font-semibold text-white hover:bg-sky-700 cursor-pointer" %>
      <% if work_shift.persisted? && can?("admin.work_shifts.delete") %>
        <%= link_to "削除", admin_work_shift_path(work_shift, from_grid: from_grid),
            data: { turbo_method: "delete" },
            class: "rounded border border-rose-200 bg-rose-50 px-2 py-1 text-xs font-semibold text-rose-700 hover:bg-rose-100" %>
      <% end %>
      <%= link_to "×", grid_admin_work_shifts_path(month: from_grid),
          class: "rounded border border-slate-200 px-2 py-1 text-xs text-slate-600 hover:bg-slate-50",
          data: { turbo_frame: "_top" } %>
    </div>
  <% end %>
</div>
