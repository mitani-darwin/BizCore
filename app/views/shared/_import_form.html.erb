<%# 共通インポートフォームパーシャル
    locals: resource_label, import_path, template_path, headers %>

<div class="space-y-6">

  <%# 操作メッセージ %>
  <% if flash[:alert].present? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
      <%= flash[:alert] %>
    </div>
  <% end %>
  <% if flash.now[:alert].present? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
      <%= flash.now[:alert] %>
    </div>
  <% end %>

  <%# インポート結果 %>
  <% if local_assigns[:import_result].present? %>
    <% result = local_assigns[:import_result] %>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-800">インポート結果</h2>
      <div class="mt-3 grid grid-cols-3 gap-4 text-center">
        <div class="rounded-lg bg-slate-50 p-3">
          <div class="text-xs text-slate-500">総行数</div>
          <div class="text-2xl font-bold text-slate-900"><%= result.total %></div>
        </div>
        <div class="rounded-lg bg-emerald-50 p-3">
          <div class="text-xs text-emerald-700">成功</div>
          <div class="text-2xl font-bold text-emerald-700"><%= result.succeeded %></div>
        </div>
        <div class="rounded-lg bg-rose-50 p-3">
          <div class="text-xs text-rose-700">エラー</div>
          <div class="text-2xl font-bold text-rose-700"><%= result.failed_rows.size %></div>
        </div>
      </div>

      <% if result.failed_rows.any? %>
        <div class="mt-4">
          <h3 class="text-xs font-semibold text-rose-800 mb-2">エラー行の詳細</h3>
          <div class="overflow-x-auto">
            <table class="min-w-full text-xs border-collapse">
              <thead>
                <tr class="bg-rose-50">
                  <th class="border border-rose-200 px-3 py-2 text-left font-semibold text-rose-800">行</th>
                  <% if result.failed_rows.first[:data].present? %>
                    <% result.failed_rows.first[:data].each_key do |col| %>
                      <th class="border border-rose-200 px-3 py-2 text-left font-semibold text-rose-800"><%= col %></th>
                    <% end %>
                  <% end %>
                  <th class="border border-rose-200 px-3 py-2 text-left font-semibold text-rose-800">エラー内容</th>
                </tr>
              </thead>
              <tbody>
                <% result.failed_rows.each do |row_info| %>
                  <tr class="bg-white">
                    <td class="border border-rose-100 px-3 py-2 text-rose-700 font-medium"><%= row_info[:row] %>行目</td>
                    <% row_info[:data].each_value do |val| %>
                      <td class="border border-rose-100 px-3 py-2 text-slate-700"><%= val %></td>
                    <% end %>
                    <td class="border border-rose-100 px-3 py-2 text-rose-700"><%= row_info[:errors].join(", ") %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>

      <% if result.succeeded > 0 %>
        <div class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
          <%= result.succeeded %> 件を登録/更新しました。
        </div>
      <% end %>
    </div>
  <% end %>

  <%# アップロードフォーム %>
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-800"><%= resource_label %>を CSV でインポート</h2>
    <p class="mt-1 text-xs text-slate-500">
      コードが既存の場合は更新、新規の場合は追加します。1回あたりの上限は 1,000 行です。
    </p>

    <%= form_with url: import_path, method: :post, multipart: true, class: "mt-4 space-y-4" do |f| %>
      <div>
        <label class="block text-xs font-medium text-slate-700 mb-1">CSV ファイル（UTF-8）</label>
        <input type="file" name="file" accept=".csv,text/csv" required
               class="block w-full text-sm text-slate-700 file:mr-4 file:rounded-lg file:border file:border-slate-300 file:bg-slate-50 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-slate-700 hover:file:bg-slate-100">
      </div>
      <div class="flex items-center gap-3">
        <button type="submit"
                class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">
          インポート実行
        </button>
        <%= link_to "テンプレートをダウンロード", template_path, class: "text-xs font-semibold text-sky-600 hover:underline" %>
      </div>
    <% end %>
  </div>

  <%# ヘッダー説明 %>
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-800">CSV フォーマット</h2>
    <p class="mt-1 text-xs text-slate-500">1行目はヘッダー行として読み込まれます。</p>
    <div class="mt-3 overflow-x-auto">
      <table class="min-w-full text-xs">
        <thead>
          <tr class="bg-slate-50">
            <th class="border border-slate-200 px-3 py-2 text-left font-semibold text-slate-700">列名</th>
            <th class="border border-slate-200 px-3 py-2 text-left font-semibold text-slate-700">説明</th>
          </tr>
        </thead>
        <tbody>
          <% headers.each_with_index do |(key, label), index| %>
            <tr class="<%= index.even? ? "bg-white" : "bg-slate-50/50" %>">
              <td class="border border-slate-200 px-3 py-2 font-mono text-slate-800"><%= label %></td>
              <td class="border border-slate-200 px-3 py-2 text-slate-600"><%= yield(:header_description, key) if block_given? %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>
