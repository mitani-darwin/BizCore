<% content_for :title, "日報詳細" %>

<div class="min-h-screen bg-[radial-gradient(circle_at_top_left,_rgba(14,165,233,0.10),_transparent_30%),linear-gradient(180deg,#f8fafc_0%,#eef6ff_100%)]">
  <div class="mx-auto flex min-h-screen max-w-2xl flex-col gap-6 px-4 py-6">
    <header class="rounded-3xl border border-white/70 bg-white/80 p-5 shadow-sm backdrop-blur">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-600">Daily Report</p>
          <h1 class="mt-2 text-2xl font-semibold text-slate-900">日報詳細</h1>
          <p class="mt-1 text-sm text-slate-600"><%= @daily_report.report_date.strftime("%Y/%m/%d") %></p>
        </div>
        <%= link_to "一覧へ戻る", my_daily_reports_path, class: "rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
      </div>
    </header>

    <div class="rounded-3xl border border-white/70 bg-white/80 p-6 shadow-sm backdrop-blur">
      <dl class="space-y-4 text-sm text-slate-800">
        <div>
          <dt class="text-xs text-slate-500">現場</dt>
          <dd class="mt-1 font-semibold text-slate-900"><%= @daily_report.site.name %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">作業日</dt>
          <dd class="mt-1"><%= @daily_report.report_date.strftime("%Y/%m/%d") %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">作業時間</dt>
          <dd class="mt-1"><%= @daily_report.work_hours %>時間</dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500">作業内容</dt>
          <dd class="mt-1 rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
            <%= simple_format(@daily_report.work_content) %>
          </dd>
        </div>
        <% if @daily_report.notes.present? %>
          <div>
            <dt class="text-xs text-slate-500">備考</dt>
            <dd class="mt-1 rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
              <%= simple_format(@daily_report.notes) %>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>

    <%# 写真ギャラリー %>
    <% if @daily_report.photos.attached? %>
      <div class="rounded-3xl border border-white/70 bg-white/80 p-6 shadow-sm backdrop-blur">
        <h2 class="text-sm font-semibold text-slate-900">写真 (<%= @daily_report.photos.count %>枚)</h2>
        <div class="mt-3 grid grid-cols-2 gap-3">
          <% @daily_report.photos.each do |photo| %>
            <div class="overflow-hidden rounded-xl border border-slate-200">
              <%= image_tag photo, class: "h-40 w-full object-cover" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="flex gap-2">
      <%= link_to "一覧へ戻る", my_daily_reports_path, class: "rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
      <%= link_to "編集", edit_my_daily_report_path(@daily_report), class: "rounded-full border border-sky-200 bg-sky-50 px-4 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
      <%= button_to "削除", my_daily_report_path(@daily_report), method: :delete,
          form: { data: { turbo_confirm: "この日報を削除してもよろしいですか？" } },
          class: "rounded-full border border-rose-200 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-100" %>
    </div>
  </div>
</div>
